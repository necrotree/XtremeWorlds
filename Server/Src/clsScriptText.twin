Class clsScriptText
    Option Explicit
    Private mWindow As LongPtr
    Private mHost As Object
    Public Event Change()
    Public Event SelChange()
    Public Event KeyDown(KeyCode As Integer, Shift As Integer)
    Public Event MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)

    Public Sub Attach(ByVal host As Object)
        Dim bounds As WinDevLib.RECT
        Dim format As WinDevLib.CHARFORMAT2W
        Dim face As String = "Courier New"
        Set mHost = host
        If ScriptRichLibrary = 0 Then ScriptRichLibrary = WinDevLib.LoadLibrary("msftedit.dll")
        If ScriptRichLibrary = 0 Then Err.Raise 53, , "Cannot load Windows Rich Edit."
        WinDevLib.GetClientRect host.hWnd, bounds
        mWindow = WinDevLib.CreateWindowEx(0, "RICHEDIT50W", "", WinDevLib.WS_CHILD Or WinDevLib.WS_VISIBLE Or WinDevLib.WS_TABSTOP Or WinDevLib.WS_VSCROLL Or WinDevLib.WS_HSCROLL Or WinDevLib.ES_MULTILINE Or WinDevLib.ES_AUTOVSCROLL Or WinDevLib.ES_AUTOHSCROLL, 0, 0, bounds.Right, bounds.Bottom, host.hWnd, 0, 0, ByVal vbNullPtr)
        If mWindow = 0 Then Err.Raise 5, , "Cannot create script editor."
        RegisterScriptWindow mWindow, Me
        RegisterScriptWindow host.hWnd, Me
        WinDevLib.SendMessageLong mWindow, WinDevLib.EM_EXLIMITTEXT, 0, &H7FFFFFFF
        WinDevLib.SendMessageLong mWindow, &H445, 0, &H80001 ' ENM_CHANGE | ENM_SELCHANGE
        WinDevLib.SendMessageLong mWindow, WinDevLib.EM_SETBKGNDCOLOR, 0, vbWhite
        format.cbSize = LenB(format)
        format.dwMask = WinDevLib.CFM_SIZE Or WinDevLib.CFM_FACE
        format.yHeight = 200
        WinDevLib.CopyMemory format.szFaceName(0), ByVal StrPtr(face), LenB(face)
        WinDevLib.SendMessage mWindow, WinDevLib.EM_SETCHARFORMAT, 0, format
    End Sub

    Public Function WindowMessage(ByVal window As LongPtr, ByVal message As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As Boolean
        Dim bounds As WinDevLib.RECT
        Dim key As Integer, shift As Integer
        If window = mHost.hWnd Then
            If message = WinDevLib.WM_SIZE Then
                WinDevLib.GetClientRect window, bounds
                WinDevLib.MoveWindow mWindow, 0, 0, bounds.Right, bounds.Bottom, True
            ElseIf message = WinDevLib.WM_COMMAND Then
                If lParam = mWindow And ((wParam \ &H10000) And &HFFFF&) = &H300 Then RaiseEvent Change
            ElseIf message = WinDevLib.WM_NOTIFY Then
                RaiseEvent SelChange
            End If
        ElseIf window = mWindow Then
            If message = &H304 Or message = &HC7 Or message = &H454 Then
                ' Route WM_UNDO, EM_UNDO and EM_REDO through the same text history
                ' as the menu. Rich Edit's own history also contains formatting.
                key = vbKeyZ
                If message = &H454 Then key = vbKeyY
                shift = vbCtrlMask
                RaiseEvent KeyDown(key, shift)
                Return True
            ElseIf message = WinDevLib.WM_KEYDOWN Then
                key = CInt(wParam)
                If WinDevLib.GetKeyState(vbKeyControl) < 0 Then shift = shift Or vbCtrlMask
                If WinDevLib.GetKeyState(vbKeyShift) < 0 Then shift = shift Or vbShiftMask
                RaiseEvent KeyDown(key, shift)
                Return key = 0
            ElseIf message = WinDevLib.WM_CHAR Then
                ' Form commands own clipboard and history, including their control characters.
                Select Case wParam
                    Case 1, 3, 22, 24, 25, 26: Return True
                End Select
            ElseIf message = WinDevLib.WM_CONTEXTMENU Then
                RaiseEvent MouseDown(vbRightButton, 0, 0, 0)
                Return True
            End If
        End If
    End Function
    Public Property Get hWnd() As LongPtr
        Return mWindow
    End Property
    Public Property Get Text() As String
        Dim length As Long = WinDevLib.SendMessageLong(mWindow, WinDevLib.WM_GETTEXTLENGTH, 0, 0)
        Dim buffer As String = String$(length + 1, vbNullChar)
        length = WinDevLib.SendMessageLong(mWindow, WinDevLib.WM_GETTEXT, length + 1, StrPtr(buffer))
        ' Rich Edit selection positions count each newline once.
        Return Replace(Replace(Left$(buffer, length), vbCrLf, vbLf), vbCr, vbLf)
    End Property
    Public Property Let Text(ByVal value As String)
        WinDevLib.SendMessageLong mWindow, WinDevLib.WM_SETTEXT, 0, StrPtr(value)
    End Property
    Public Property Get SelStart() As Long
        Dim selection As WinDevLib.CHARRANGE
        WinDevLib.SendMessage mWindow, WinDevLib.EM_EXGETSEL, 0, selection
        Return selection.cpMin
    End Property
    Public Property Let SelStart(ByVal value As Long)
        Dim selection As WinDevLib.CHARRANGE
        selection.cpMin = value
        selection.cpMax = value
        WinDevLib.SendMessage mWindow, WinDevLib.EM_EXSETSEL, 0, selection
    End Property
    Public Property Get SelLength() As Long
        Dim selection As WinDevLib.CHARRANGE
        WinDevLib.SendMessage mWindow, WinDevLib.EM_EXGETSEL, 0, selection
        Return selection.cpMax - selection.cpMin
    End Property
    Public Property Let SelLength(ByVal value As Long)
        Dim selection As WinDevLib.CHARRANGE
        WinDevLib.SendMessage mWindow, WinDevLib.EM_EXGETSEL, 0, selection
        selection.cpMax = selection.cpMin + value
        WinDevLib.SendMessage mWindow, WinDevLib.EM_EXSETSEL, 0, selection
    End Property
    Public Property Get SelText() As String
        Return Mid$(Text, SelStart + 1, SelLength)
    End Property
    Public Property Let SelText(ByVal value As String)
        WinDevLib.SendMessageLong mWindow, WinDevLib.EM_REPLACESEL, 0, StrPtr(value)
    End Property
    Public Property Let SelColor(ByVal value As Long)
        Dim format As WinDevLib.CHARFORMAT2W
        format.cbSize = LenB(format)
        format.dwMask = WinDevLib.CFM_COLOR
        format.crTextColor = value
        WinDevLib.SendMessage mWindow, WinDevLib.EM_SETCHARFORMAT, WinDevLib.SCF_SELECTION, format
    End Property
    Public Sub Move(ByVal left As Single, ByVal top As Single, ByVal width As Single, ByVal height As Single)
        If mHost.Left = left And mHost.Top = top And mHost.Width = width And mHost.Height = height Then Return
        mHost.Move left, top, width, height
    End Sub
    Public Sub SetFocus()
        WinDevLib.SetFocus mWindow
        WinDevLib.SendMessageLong mWindow, WinDevLib.EM_SCROLLCARET, 0, 0
    End Sub
    Public Sub Refresh()
        ' The text is a native child window. Refreshing only its PictureBox host
        ' can erase the code without repainting it after WM_SETREDRAW is enabled.
        WinDevLib.InvalidateRect mWindow, ByVal vbNullPtr, True
        WinDevLib.UpdateWindow mWindow
    End Sub
End Class
