Option Explicit
    Public ScriptRichLibrary As LongPtr
    Private ScriptWindows As New Collection
    Public Sub RegisterScriptWindow(ByVal window As LongPtr, ByVal editor As clsScriptText)
        ScriptWindows.Add editor, CStr(window)
        If WinDevLib.SetWindowSubclass(window, AddressOf ScriptWindowProc, 1, 0) = 0 Then
            ScriptWindows.Remove CStr(window)
            Err.Raise 5, , "Cannot attach script editor events."
        End If
    End Sub
    Public Function ScriptWindowProc(ByVal window As LongPtr, ByVal message As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr, ByVal subclassId As LongPtr, ByVal reference As LongPtr) As LongPtr
        Dim editor As clsScriptText
        On Error GoTo DefaultProcessing
        Set editor = ScriptWindows(CStr(window))
        If editor.WindowMessage(window, message, wParam, lParam) Then Return 0
DefaultProcessing:
        If message = WinDevLib.WM_NCDESTROY Then
            WinDevLib.RemoveWindowSubclass window, AddressOf ScriptWindowProc, 1
            On Error Resume Next
            ScriptWindows.Remove CStr(window)
        End If
        Return WinDevLib.DefSubclassProc(window, message, wParam, lParam)
    End Function
End Module
