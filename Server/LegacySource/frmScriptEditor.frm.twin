[FormDesignerId("76D68BBD-030F-48AA-97D8-9DF693291AA2")]
Class frmScriptEditor
Attribute VB_PredeclaredId = True
Option Explicit
Private WithEvents txtCode As clsScriptText

Private Declare Function SendMessage Lib "user32" Alias "SendMessageA" (ByVal hwnd As LongPtr, ByVal msg As Long, ByVal wParam As Long, ByVal lParam As Long) As Long
Private Type EditorScrollPoint
    X As Long
    Y As Long
End Type
Private Declare Function SendScrollMessage Lib "user32" Alias "SendMessageA" (ByVal hwnd As LongPtr, ByVal msg As Long, ByVal wParam As Long, ByRef point As EditorScrollPoint) As Long
Private Declare Function GetCharPosition Lib "user32" Alias "SendMessageA" (ByVal hwnd As LongPtr, ByVal msg As Long, ByRef point As EditorScrollPoint, ByVal charIndex As Long) As Long
Private Declare Function MapEditorPoint Lib "user32" Alias "MapWindowPoints" (ByVal fromWindow As LongPtr, ByVal toWindow As LongPtr, ByRef point As EditorScrollPoint, ByVal count As Long) As Long
Private mGutterState As String
Private mBusy As Boolean
Private mPath As String
Private mSaved As String
Private mHistory As Collection
Private mHistoryIndex As Long
Private mStarts As Collection
Private Const HISTORY_LIMIT As Long = 100

Private Sub Form_Load()
    mBusy = True
    Set txtCode = New clsScriptText
    txtCode.Attach hostCode
    ScaleMode = vbTwips
    picLineNumbers.ScaleMode = vbPixels
    picLineNumbers.AutoRedraw = True
    picLineNumbers.Font.Name = "Courier New"
    picLineNumbers.Font.Size = 10
    tmrLineNumbers.Enabled = True
    ResetDocument vbNullString, vbNullString
    RefreshFiles
    If Len(Dir$(App.Path & "\scripts\Main.as")) > 0 Then LoadScript App.Path & "\scripts\Main.as"
End Sub

Private Sub Form_Resize()
    If WindowState = vbMinimized Or txtCode Is Nothing Then Exit Sub
    If Width < 10000 Then Width = 10000
    If Height < 6000 Then Height = 6000
    lstFiles.Move 120, 480, 2220, ScaleHeight - 1035
    cmdDelete.Move 120, ScaleHeight - 435, 2220, 315
    LayoutCodePane
    cboProcedures.Width = ScaleWidth - 6600
    cmdSave.Left = ScaleWidth - 4020
    cmdSaveAs.Left = ScaleWidth - 2760
    cmdNew.Left = ScaleWidth - 1380
    DrawLineNumbers True
End Sub

Private Sub LayoutCodePane()
    Dim gutterWidth As Single, lineCount As Long
    lineCount = SendMessage(txtCode.hwnd, &HBA, 0, 0) ' EM_GETLINECOUNT
    gutterWidth = picLineNumbers.TextWidth(CStr(lineCount)) + 8
    If gutterWidth < 24 Then gutterWidth = 24
    gutterWidth = gutterWidth * Screen.TwipsPerPixelX
    picLineNumbers.Move 2400, 480, gutterWidth, ScaleHeight - 600
    txtCode.Move 2400 + gutterWidth, 480, ScaleWidth - 2520 - gutterWidth, ScaleHeight - 600
End Sub

Private Sub tmrLineNumbers_Timer()
    If Not mBusy And WindowState <> vbMinimized Then DrawLineNumbers
End Sub

Private Sub DrawLineNumbers(Optional ByVal force As Boolean = False)
    Dim firstLine As Long, lineCount As Long, line As Long, charIndex As Long
    Dim point As EditorScrollPoint, ignored As Long, state As String, number As String
    If mBusy Or txtCode Is Nothing Then Exit Sub
    firstLine = SendMessage(txtCode.hwnd, &HCE, 0, 0) ' EM_GETFIRSTVISIBLELINE
    lineCount = SendMessage(txtCode.hwnd, &HBA, 0, 0)
    charIndex = SendMessage(txtCode.hwnd, &HBB, firstLine, 0) ' EM_LINEINDEX
    ignored = GetCharPosition(txtCode.hwnd, &H426, point, charIndex) ' EM_POSFROMCHAR
    state = CStr(firstLine) & ":" & CStr(lineCount) & ":" & CStr(point.Y) & ":" & CStr(ScaleHeight) & ":" & CStr(ScaleWidth)
    If Not force And state = mGutterState Then Exit Sub
    mGutterState = state
    LayoutCodePane
    picLineNumbers.Cls
    For line = firstLine To lineCount - 1
        charIndex = SendMessage(txtCode.hwnd, &HBB, line, 0)
        If charIndex < 0 Then Exit For
        ignored = GetCharPosition(txtCode.hwnd, &H426, point, charIndex)
        ' Map the text baseline origin into the gutter, including control borders.
        ignored = MapEditorPoint(txtCode.hwnd, picLineNumbers.hwnd, point, 1)
        If point.Y >= picLineNumbers.ScaleHeight Then Exit For
        number = CStr(line + 1)
        picLineNumbers.CurrentX = picLineNumbers.ScaleWidth - picLineNumbers.TextWidth(number) - 4
        picLineNumbers.CurrentY = point.Y
        picLineNumbers.Print number
    Next
    picLineNumbers.Refresh
End Sub

Private Sub RefreshFiles()
    Dim name As String
    mBusy = True
    lstFiles.Clear
    name = Dir$(App.Path & "\scripts\*.*")
    Do While Len(name) > 0
        Select Case LCase$(Mid$(name, InStrRev(name, ".") + 1))
            Case "as", "vbs", "txt": lstFiles.AddItem name
        End Select
        name = Dir$()
    Loop
    mBusy = False
End Sub

Private Sub ResetDocument(ByVal content As String, ByVal path As String)
    mBusy = True
    txtCode.Text = content
    mPath = path
    mSaved = txtCode.Text
    Set mHistory = New Collection
    mHistory.Add txtCode.Text
    mHistoryIndex = 1
    mBusy = False
    HighlightCode
    UpdateStatus
End Sub

Private Function CanLeave() As Boolean
    Dim answer As VbMsgBoxResult
    CanLeave = True
    If txtCode.Text = mSaved Then Exit Function
    answer = MsgBox("Save changes to this script?", vbYesNoCancel Or vbQuestion, "Script Editor")
    If answer = vbCancel Then CanLeave = False
    If answer = vbYes Then CanLeave = SaveScript(False)
End Function

Private Sub LoadScript(ByVal path As String)
    Dim handle As Integer, content As String, message As String
    On Error GoTo Failed
    handle = FreeFile
    Open path For Binary Access Read As #handle
    content = Space$(LOF(handle))
    If Len(content) > 0 Then Get #handle,, content
    Close #handle
    handle = 0
    ResetDocument content, path
    Exit Sub
Failed:
    message = Err.Description
    On Error Resume Next
    If handle <> 0 Then Close #handle
    MsgBox "Cannot open script: " & message, vbExclamation
End Sub

Private Sub lstFiles_Click()
    If mBusy Or lstFiles.ListIndex < 0 Then Exit Sub
    If CanLeave Then LoadScript App.Path & "\scripts\" & lstFiles.List(lstFiles.ListIndex)
End Sub

Private Function SaveScript(ByVal saveAs As Boolean) As Boolean
    Dim path As String, name As String, ch As Variant, handle As Integer
    Dim tempPath As String, backupPath As String, content As String, moved As Boolean
    On Error GoTo Failed
    path = mPath
    If saveAs Or Len(path) = 0 Then
        name = InputBox("File name in the server scripts folder (.as, .vbs or .txt):", "Save Script", "NewScript.as")
        If Len(name) = 0 Then Exit Function
        If name <> Trim$(name) Or Right$(name, 1) = "." Then GoTo InvalidName
        For Each ch In Array("\", "/", ":", "*", "?", Chr$(34), "<", ">", "|")
            If InStr(name, CStr(ch)) > 0 Then GoTo InvalidName
        Next
        Select Case LCase$(Mid$(name, InStrRev(name, ".") + 1))
            Case "as", "vbs", "txt"
            Case Else: GoTo InvalidName
        End Select
        path = App.Path & "\scripts\" & name
        If Len(Dir$(path)) > 0 Then
            If MsgBox("Replace " & name & "?", vbYesNo Or vbQuestion) <> vbYes Then Exit Function
        End If
    End If
    If Len(Dir$(App.Path & "\scripts", vbDirectory)) = 0 Then MkDir App.Path & "\scripts"
    ' Write completely before replacing the original; retain it if writing fails.
    tempPath = path & ".editing"
    backupPath = path & ".previous"
    If Len(Dir$(tempPath)) > 0 Or Len(Dir$(backupPath)) > 0 Then
        MsgBox "A recovery file already exists beside this script. Move the .editing or .previous file before saving.", vbExclamation
        Exit Function
    End If
    handle = FreeFile
    Open tempPath For Binary Access Write As #handle
    content = Replace(Replace(Replace(txtCode.Text, vbCrLf, vbLf), vbCr, vbLf), vbLf, vbCrLf)
    If Len(content) > 0 Then Put #handle,, content
    Close #handle
    handle = 0
    If Len(Dir$(path)) > 0 Then
        Name path As backupPath
        moved = True
    End If
    Name tempPath As path
    mPath = path
    mSaved = txtCode.Text
    SaveScript = True
    If moved Then Kill backupPath
    RefreshFiles
    UpdateStatus
    Exit Function
InvalidName:
    MsgBox "Enter a file name ending in .as, .vbs or .txt, without a folder path.", vbExclamation
    Exit Function
Failed:
    MsgBox "Cannot save script: " & Err.Description, vbExclamation
    On Error Resume Next
    If handle <> 0 Then Close #handle
    If moved And Len(Dir$(path)) = 0 Then Name backupPath As path
End Function

Private Sub cmdSave_Click()
    SaveScript False
End Sub
Private Sub cmdSaveAs_Click()
    SaveScript True
End Sub
Private Sub cmdDelete_Click()
    Dim prompt As String
    If Len(mPath) = 0 Then Exit Sub
    prompt = "Delete " & Mid$(mPath, InStrRev(mPath, "\") + 1) & " from disk?"
    If txtCode.Text <> mSaved Then prompt = prompt & vbCrLf & "Unsaved changes to this script will also be discarded."
    If MsgBox(prompt, vbYesNo Or vbQuestion Or vbDefaultButton2, "Delete Script") <> vbYes Then Exit Sub
    DeleteCurrentScript
End Sub

Private Function DeleteCurrentScript() As Boolean
    On Error GoTo Failed
    If Len(mPath) = 0 Then Exit Function
    Kill mPath
    ResetDocument vbNullString, vbNullString
    RefreshFiles
    DeleteCurrentScript = True
    Exit Function
Failed:
    MsgBox "Cannot delete script: " & Err.Description, vbExclamation
End Function

Private Sub CaptureScroll(ByRef point As EditorScrollPoint, ByRef topLine As Long, ByRef pixels As Boolean)
    topLine = SendMessage(txtCode.hwnd, &HCE, 0, 0)
    pixels = (SendScrollMessage(txtCode.hwnd, &H4DD, 0, point) <> 0)
End Sub

Private Sub RestoreScroll(ByRef point As EditorScrollPoint, ByVal topLine As Long, ByVal pixels As Boolean)
    Dim ignored As Long
    If pixels Then
        ignored = SendScrollMessage(txtCode.hwnd, &H4DE, 0, point)
    Else
        ignored = SendMessage(txtCode.hwnd, &HB6, 0, topLine - SendMessage(txtCode.hwnd, &HCE, 0, 0))
    End If
End Sub

Private Sub cmdNew_Click()
    If CanLeave Then ResetDocument "' SadScript include file" & vbCrLf, vbNullString
End Sub
Private Sub mnuSave_Click()
    cmdSave_Click
End Sub
Private Sub mnuSaveAs_Click()
    cmdSaveAs_Click
End Sub
Private Sub mnuClose_Click()
    Unload Me
End Sub
Private Sub Form_QueryUnload(Cancel As Integer, UnloadMode As Integer)
    If Not CanLeave Then Cancel = 1
End Sub

Private Sub txtCode_Change()
    If mBusy Then Exit Sub
    ' Keep text history separately: coloring must never become an undo operation.
    If txtCode.Text <> CStr(mHistory(mHistoryIndex)) Then
        Do While mHistory.Count > mHistoryIndex
            mHistory.Remove mHistory.Count
        Loop
        mHistory.Add txtCode.Text
        If mHistory.Count > HISTORY_LIMIT Then mHistory.Remove 1
        mHistoryIndex = mHistory.Count
    End If
    tmrHighlight.Enabled = False
    tmrHighlight.Enabled = True
    UpdateStatus
End Sub

Private Sub RestoreHistory(ByVal direction As Long)
    Dim caret As Long, selectionLength As Long, topLine As Long, ignored As Long
    Dim point As EditorScrollPoint, pixels As Boolean
    If mHistoryIndex + direction < 1 Or mHistoryIndex + direction > mHistory.Count Then Exit Sub
    caret = txtCode.SelStart
    selectionLength = txtCode.SelLength
    CaptureScroll point, topLine, pixels
    tmrHighlight.Enabled = False
    ignored = SendMessage(txtCode.hwnd, &HB, 0, 0)
    mHistoryIndex = mHistoryIndex + direction
    mBusy = True
    txtCode.Text = CStr(mHistory(mHistoryIndex))
    If caret > Len(txtCode.Text) Then caret = Len(txtCode.Text)
    If selectionLength > Len(txtCode.Text) - caret Then selectionLength = Len(txtCode.Text) - caret
    txtCode.SelStart = caret
    txtCode.SelLength = selectionLength
    mBusy = False
    HighlightCode False
    RestoreScroll point, topLine, pixels
    ignored = SendMessage(txtCode.hwnd, &HB, 1, 0)
    txtCode.Refresh
    UpdateStatus
End Sub
Private Sub mnuUndo_Click()
    RestoreHistory -1
End Sub
Private Sub mnuRedo_Click()
    RestoreHistory 1
End Sub
Private Sub mnuCopy_Click()
    If txtCode.SelLength = 0 Then Exit Sub
    Clipboard.Clear
    Clipboard.SetText txtCode.SelText
End Sub
Private Sub mnuCut_Click()
    If txtCode.SelLength = 0 Then Exit Sub
    mnuCopy_Click
    txtCode.SelText = vbNullString
End Sub
Private Sub mnuPaste_Click()
    If Clipboard.GetFormat(vbCFText) Then txtCode.SelText = Clipboard.GetText(vbCFText)
End Sub
Private Sub mnuSelectAll_Click()
    txtCode.SetFocus
    txtCode.SelStart = 0
    txtCode.SelLength = Len(txtCode.Text)
End Sub
Private Sub txtCode_KeyDown(KeyCode As Integer, Shift As Integer)
    If (Shift And vbCtrlMask) = 0 Then Exit Sub
    Select Case KeyCode
        Case vbKeyS: cmdSave_Click
        Case vbKeyZ: mnuUndo_Click
        Case vbKeyY: mnuRedo_Click
        Case vbKeyC: mnuCopy_Click
        Case vbKeyX: mnuCut_Click
        Case vbKeyV: mnuPaste_Click
        Case vbKeyA: mnuSelectAll_Click
        Case Else: Exit Sub
    End Select
    KeyCode = 0
End Sub
Private Sub txtCode_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
    If Button = vbRightButton Then PopUpMenu mnuEdit
End Sub
Private Sub txtCode_SelChange()
    If Not mBusy Then UpdateStatus
End Sub
Private Sub UpdateStatus()
    Caption = "Script Editor - " & IIf(Len(mPath) = 0, "Untitled", Mid$(mPath, InStrRev(mPath, "\") + 1))
    If txtCode.Text <> mSaved Then Caption = Caption & " *"
    cmdDelete.Enabled = (Len(mPath) > 0)
    mnuUndo.Enabled = (mHistoryIndex > 1)
    mnuRedo.Enabled = (mHistoryIndex < mHistory.Count)
    DrawLineNumbers
End Sub

Private Sub tmrHighlight_Timer()
    tmrHighlight.Enabled = False
    HighlightCode
End Sub
Private Sub PaintToken(ByVal start As Long, ByVal count As Long, ByVal color As Long)
    txtCode.SelStart = start - 1
    txtCode.SelLength = count
    txtCode.SelColor = color
End Sub
Private Function IsWord(ByVal ch As String) As Boolean
    If Len(ch) = 0 Then Exit Function
    IsWord = (ch Like "[A-Za-z0-9_]")
End Function
Private Sub HighlightCode(Optional ByVal redraw As Boolean = True)
    Dim code As String, pos As Long, first As Long, ch As String, word As String
    Dim selection As Long, length As Long, topLine As Long, ignored As Long
    Dim keywords As String
    Dim point As EditorScrollPoint, pixels As Boolean
    If mBusy Then Exit Sub
    On Error GoTo Done
    mBusy = True
    selection = txtCode.SelStart
    length = txtCode.SelLength
    CaptureScroll point, topLine, pixels
    ignored = SendMessage(txtCode.hwnd, &HB, 0, 0)
    code = txtCode.Text
    txtCode.SelStart = 0
    txtCode.SelLength = Len(code)
    txtCode.SelColor = RGB(25, 25, 25)
    keywords = "|sub|function|end|public|private|const|dim|redim|preserve|if|then|else|elseif|select|case|for|each|in|to|step|next|do|loop|while|until|wend|exit|call|set|let|byval|byref|and|or|not|xor|mod|true|false|nothing|empty|null|on|error|resume|option|explicit|new|"
    pos = 1
    Do While pos <= Len(code)
        first = pos
        ch = Mid$(code, pos, 1)
        If ch = "'" Or ch = "#" Then
            Do While pos <= Len(code)
                If Mid$(code, pos, 1) = vbCr Or Mid$(code, pos, 1) = vbLf Then Exit Do
                pos = pos + 1
            Loop
            If ch = "'" Then PaintToken first, pos - first, RGB(0, 128, 0) Else PaintToken first, pos - first, RGB(128, 0, 128)
        ElseIf ch = Chr$(34) Then
            pos = pos + 1
            Do While pos <= Len(code)
                ch = Mid$(code, pos, 1)
                If ch = vbCr Or ch = vbLf Then Exit Do
                pos = pos + 1
                If ch = Chr$(34) Then
                    If Mid$(code, pos, 1) <> Chr$(34) Then Exit Do
                    pos = pos + 1
                End If
            Loop
            PaintToken first, pos - first, RGB(163, 21, 21)
        ElseIf IsWord(ch) Then
            Do While IsWord(Mid$(code, pos, 1))
                pos = pos + 1
            Loop
            word = LCase$(Mid$(code, first, pos - first))
            If word = "rem" Then
                Do While pos <= Len(code)
                    If Mid$(code, pos, 1) = vbCr Or Mid$(code, pos, 1) = vbLf Then Exit Do
                    pos = pos + 1
                Loop
                PaintToken first, pos - first, RGB(0, 128, 0)
            ElseIf InStr(keywords, "|" & word & "|") > 0 Then
                PaintToken first, pos - first, RGB(0, 0, 192)
            ElseIf IsNumeric(word) Then
                PaintToken first, pos - first, RGB(128, 64, 0)
            End If
        Else
            pos = pos + 1
        End If
    Loop
    IndexProcedures code
Done:
    txtCode.SelStart = selection
    txtCode.SelLength = length
    RestoreScroll point, topLine, pixels
    If redraw Then
        ignored = SendMessage(txtCode.hwnd, &HB, 1, 0)
        txtCode.Refresh
    End If
    mBusy = False
End Sub

Private Sub IndexProcedures(ByVal code As String)
    Dim lines As Variant, entry As Variant, text As String, offset As Long, name As String, n As Long
    Set mStarts = New Collection
    cboProcedures.Clear
    lines = Split(code, vbLf)
    For Each entry In lines
        text = Trim$(Replace(Replace(CStr(entry), vbCr, ""), vbTab, " "))
        If LCase$(Left$(text, 7)) = "public " Then text = Trim$(Mid$(text, 8))
        If LCase$(Left$(text, 8)) = "private " Then text = Trim$(Mid$(text, 9))
        If LCase$(Left$(text, 4)) = "sub " Or LCase$(Left$(text, 9)) = "function " Then
            name = Trim$(Mid$(text, InStr(text, " ") + 1))
            n = InStr(name, "(")
            If n > 0 Then name = Trim$(Left$(name, n - 1))
            n = InStr(name, "'")
            If n > 0 Then name = Trim$(Left$(name, n - 1))
            cboProcedures.AddItem text
            mStarts.Add offset
        End If
        offset = offset + Len(CStr(entry)) + 1
    Next
End Sub
Private Sub cboProcedures_Click()
    If mBusy Or cboProcedures.ListIndex < 0 Then Exit Sub
    txtCode.SelStart = CLng(mStarts(cboProcedures.ListIndex + 1))
    txtCode.SelLength = 0
    txtCode.SetFocus
End Sub

Private Sub Form_KeyDown(KeyCode As Integer, Shift As Integer)
    txtCode_KeyDown KeyCode, Shift
End Sub
End Class
