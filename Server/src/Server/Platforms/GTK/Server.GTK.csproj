<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Server</RootNamespace>
    <AssemblyName>Server.GTK</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>Server.EtoProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\\..\\..\\..\\..\\Client\\Assets\\gfx\\**\\*.png" Link="gfx\\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /><ProjectReference Include="..\..\src\Server\Server.Common.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Eto.Forms" Version="2.12.0" />
    <PackageReference Include="Eto.Platform.Gtk" Version="2.12.0" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\..\src\Server\CrossPlatform\**\*.cs" Link="CrossPlatform\%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><None Include="..\..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
