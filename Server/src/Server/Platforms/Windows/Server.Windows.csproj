<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Server</RootNamespace>
    <AssemblyName>Server.Windows</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>..\..\src\Server\Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\\..\\..\\..\\..\\Client\\Assets\\gfx\\**\\*.png" Link="gfx\\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /><ProjectReference Include="..\..\src\Server\Server.Common.csproj" /></ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Server\Program.cs" Link="Program.cs" />
    <Compile Include="..\..\src\Server\ServerForm.cs" Link="ServerForm.cs" />
    <Compile Include="..\..\src\Server\WpfServerSkin.cs" Link="WpfServerSkin.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Server\Icon.ico" Link="Icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
