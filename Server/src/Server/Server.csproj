<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Server</RootNamespace>
    <AssemblyName>Server</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.vb;$(ProjectDir)src\**</DefaultItemExcludes>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="com.MirrorNetworking.Telepathy" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Database\**\*.cs" />
    <Compile Include="Game\**\*.cs" />
    <Compile Include="Models\**\*.cs" />
    <Compile Include="Networking\**\*.cs" />
    <Compile Include="Protocol\**\*.cs" />
    <Compile Include="Security\**\*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="ServerForm.cs" />
    <Compile Include="ScriptEditorForm.cs" />
    <Compile Include="WpfServerSkin.cs" />
    <Compile Include="ServerHost.cs" />
    <Compile Include="ServerSettings.cs" />
    <Compile Include="ServerLogWriter.cs" />
    <Compile Include="SpacetimeLocalProcess.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="Always" />
    <Content Include="Icon.ico" CopyToOutputDirectory="Always" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\SpacetimeDb\**\*" Link="spacetimedb\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\..\SpacetimeDb\bin\**;..\..\SpacetimeDb\obj\**" CopyToOutputDirectory="Always" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="scripts\" />
  </ItemGroup>


  <Target Name="CleanSpacetimeModuleOutput" BeforeTargets="PrepareForBuild">
    <RemoveDir Directories="$(OutDir)spacetimedb" />
  </Target>

</Project>
