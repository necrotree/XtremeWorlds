<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Server</RootNamespace>
    <AssemblyName>Server.macOS</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>Server.EtoProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\..\src\Server\Server.Common.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Eto.Forms" Version="2.12.0" />
    <PackageReference Include="Eto.Platform.Mac64" Version="2.12.0" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\..\src\Server\CrossPlatform\**\*.cs" Link="CrossPlatform\%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><None Include="..\..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="Always" /></ItemGroup>

  <ItemGroup>
    <None Include="..\..\SpacetimeDb\**\*"
          Link="spacetimedb\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\..\SpacetimeDb\bin\**;..\..\SpacetimeDb\obj\**"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
