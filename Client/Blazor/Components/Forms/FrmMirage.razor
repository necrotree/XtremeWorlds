@implements IAsyncDisposable
@inject Client.Blazor.Services.BrowserGameSession Session
@inject IJSRuntime JS

<PageTitle>XtremeWorlds — frmMirage</PageTitle>
<section class="mirage" aria-label="Game window">
    <div class="game-frame">
        <div class="game-overlay-header"><div class="character-card"><b>@CurrentPlayerName</b><div class="hp">Health</div><div class="mp">Spirit</div><div class="xp">Experience</div></div><strong class="map-name">@CurrentMapName</strong><div class="game-menu"><button @onclick="ToggleEditor">Edit</button><button @onclick="ToggleGraphics">Graphics</button><button @onclick="Session.Disconnect">X</button></div></div>
    <canvas @ref="canvas" width="950" height="700" tabindex="0" aria-label="XtremeWorlds game. Click to focus; type to chat and press Enter to send."></canvas> 
        @if (editorOpen) { <WorldEditor OnClose="ToggleEditor" /> }
        @if (graphicsOpen) { <div class="graphics-popover"><button @onclick="ToggleGraphics">Close</button><GraphicsManager /></div> }
    </div>
    <p role="status">@Session.Status</p>
    <button @onclick="Session.Disconnect">Return to main menu</button>
</section>

@code {
    private bool editorOpen;
    private bool graphicsOpen;
    private void ToggleGraphics() => graphicsOpen = !graphicsOpen;
    private string CurrentPlayerName => string.IsNullOrWhiteSpace(Session.LatestWorld?.Player?.Name) ? "Player" : Session.LatestWorld.Player.Name;
    private string lastPlayerName = "";
    private string CurrentMapName => string.IsNullOrWhiteSpace(Session.CurrentMapName) ? "Map" : Session.CurrentMapName;
    private string lastMapName = "";
    private async Task ToggleEditor()
    {
        editorOpen = !editorOpen;
        if (!editorOpen && module is not null)
        {
            await InvokeAsync(StateHasChanged);
            await module.InvokeVoidAsync("focusGame", canvas);
        }
    }
    private ElementReference canvas;
    private IJSObjectReference? module;
    private DotNetObjectReference<FrmMirage>? reference;
    private readonly CancellationTokenSource cancellation = new();
    private Task? polling;
    private string? savedMapDraft;
    private bool savedMapApplied;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./game-stream.js?v=3");
        reference = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("attach", canvas, reference, $"/game-frames/{Session.Renderer.StreamId}");
        lastMapName = CurrentMapName;
        lastPlayerName = CurrentPlayerName;
        try { savedMapDraft = await JS.InvokeAsync<string?>("worldEditor.load"); }
        catch (JSException) { savedMapDraft = null; }
        polling = PollAsync();
    }
    [JSInvokable] public void Click(int x, int y) { if (!editorOpen) Session.Renderer.Click(x, y); }
    [JSInvokable] public void Key(string key) { if (!editorOpen) Session.Renderer.Key(key); }
    [JSInvokable] public void Movement(string key, bool down) { if (!editorOpen) Session.Renderer.Movement(key, down); }
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(20));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellation.Token))
                await InvokeAsync(() =>
                {
                    var status = Session.Status;
                    Session.Poll();
                    if (!savedMapApplied && !string.IsNullOrWhiteSpace(savedMapDraft)
                        && Session.LatestWorld?.Map is { Tiles.Count: 192 })
                    {
                        savedMapApplied = true;
                        try { Session.ApplyMapDraft(savedMapDraft); }
                        catch (ArgumentException) { }
                        catch (System.Text.Json.JsonException) { }
                    }
                    var mapName = CurrentMapName;
                    if (status != Session.Status || lastMapName != mapName || lastPlayerName != CurrentPlayerName)
                    {
                        lastMapName = mapName;
                        lastPlayerName = CurrentPlayerName;
                        StateHasChanged();
                    }
                });
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { }
    }
    public async ValueTask DisposeAsync()
    {
        await cancellation.CancelAsync();
        if (polling is not null) await polling;
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("detach", canvas); await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        reference?.Dispose();
        cancellation.Dispose();
    }
}
