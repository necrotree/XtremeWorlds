@using Microsoft.AspNetCore.Components.Forms
@inject Client.Blazor.Services.BrowserGameSession Session
@inject IJSRuntime JS
@implements IDisposable

<section class="graphics-manager">
    <h3>@(TilesetNumber > 0 ? "Tileset Graphics" : "Event Graphics")</h3>
    <p>Manage graphics on the game server (administrator access level 9).</p>
    @if (TilesetNumber == 0) {
    @if(TilesetNumber == 0)
    {
    <label>Graphic <select @bind="assetType">
        <option value="sprites.png">Player sprites</option>
        <option value="items.png">Items</option>
        <option value="npcs.png">NPCs</option>
        <option value="spells.png">Spells</option>
        <option value="tiles">Tileset</option>
    </select></label>
    }
    @if(TilesetNumber == 0 && assetType=="tiles")
    {
        <label>Tileset number <input type="number" min="1" max="999" @bind="tileset" /></label>
    }
    <label>Import PNG <InputFile OnChange="ImportGraphic" accept="image/png" /></label>
    <div class="connection-actions">
        <button type="button" @onclick="BrowseGraphics">Browse files to export</button>
    </div>
    @if (browsing)
    {
        <div class="graphics-file-browser">
            <h4>Server files</h4>
            <button type="button" @onclick="BrowseGraphics">Refresh</button>
            @if(Session.AvailableGraphics.Length == 0) { <p>No files found or the list is loading.</p> }
            @foreach(var name in Session.AvailableGraphics)
            {
                <div class="graphics-file-row">
                    <span>@name</span>
                    <button type="button" @onclick="() => ExportGraphic(name)">Export</button>
                </div>
            }
        </div>
    }
    @if(!string.IsNullOrWhiteSpace(status)) { <p role="status">@status</p> }
    @if(!string.IsNullOrWhiteSpace(Session.GraphicsError)) { <p role="alert">@Session.GraphicsError</p> }
    @if(!string.IsNullOrWhiteSpace(Session.GraphicsSaved)) { <p role="status">Saved on game server: @Session.GraphicsSaved</p> }
</section>

@code {
    [Parameter] public int TilesetNumber { get; set; }
    [Parameter] public int TilesetNumber { get; set; }
    [Parameter] public bool EventMode { get; set; }
    private bool browsing;
    private string assetType="sprites.png";
    private int tileset=1;
    private string status="";
    private byte[]? lastExport;
    private string CurrentName => TilesetNumber > 0 ? $"tiles{Math.Clamp(TilesetNumber,1,999)}.png" : assetType=="tiles" ? $"tiles{Math.Clamp(tileset,1,999)}.png" : assetType;
    protected override void OnInitialized() { Session.Changed += Update; if(EventMode) assetType="npcs.png"; }
    private void Update() => _ = InvokeAsync(StateHasChanged);
    private async Task ImportGraphic(InputFileChangeEventArgs args)
    {
        try
        {
            using var stream=args.File.OpenReadStream(4194304);
            using var memory=new MemoryStream();
            await stream.CopyToAsync(memory);
            var data=memory.ToArray();
            if(data.Length<24 || !data.AsSpan(0,8).SequenceEqual(new byte[]{137,80,78,71,13,10,26,10}))
                throw new ArgumentException("Select a PNG image.");
            Session.UploadGraphic(CurrentName,data);
            status="Uploading graphic to the game server...";
        }
        catch(Exception ex) when(ex is IOException or ArgumentException or InvalidOperationException)
        { status=ex.Message; }
    }
    private void BrowseGraphics()
    {
        browsing = true;
        try { Session.RequestGraphicsList(); status="Loading files from server..."; }
        catch (InvalidOperationException ex) { status=ex.Message; }
    }
    private void ExportGraphic(string name)
    {
        try { lastExport=null; Session.DownloadGraphic(name); status="Exporting " + name; }
        catch(InvalidOperationException ex) { status=ex.Message; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(Session.DownloadedGraphics is not { } data || ReferenceEquals(data,lastExport))return;
        lastExport=data;
        await JS.InvokeVoidAsync("downloadServerGraphic",Session.DownloadedGraphicsName ?? "graphic.png",Convert.ToBase64String(data));
        status="Graphic exported.";
    }
    public void Dispose() => Session.Changed -= Update;
}
