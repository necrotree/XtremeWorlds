@implements IAsyncDisposable
@inject Client.Blazor.Services.BrowserGameSession Session

<PageTitle>XtremeWorlds Client</PageTitle>
<main>
    <img class="menu-logo" src="assets/frmMainMenu/logo.png" alt="XtremeWorlds" />
    @if (page == "main")
    {
        <nav class="menu-choices" aria-label="Main menu">
            <button @onclick='() => page = "login"'>Login</button>
            <button @onclick='() => page = "register"'>Register</button>
            <a href="https://www.xtremeworlds.com" target="_blank" rel="noopener">Website</a>
        </nav>
    }
    else if (Session.Characters.Length == 0)
    {
    <h1>@(page == "register" ? "Create account" : "Login")</h1>
    <form @onsubmit="Login" @onsubmit:preventDefault>
        <label for="username">Username</label>
        <input id="username" @bind="username" autocomplete="username" maxlength="64" required />
        <label for="password">Password</label>
        <input id="password" @bind="password" type="password" autocomplete="@(page == "register" ? "new-password" : "current-password")" maxlength="128" required />
        @if (page == "register")
        {
            <label for="verify">Confirm password</label>
            <input id="verify" @bind="verify" type="password" autocomplete="new-password" maxlength="128" required />
        }
        <div>
            <button type="submit">@(page == "register" ? "Create account" : "Sign in")</button>
            <button type="button" @onclick="Back">Back</button>
            <button type="button" @onclick="Session.Disconnect" disabled="@(!Session.Connected)">Disconnect</button>
        </div>
    </form>
    }
    <p role="status" aria-live="polite">@Session.Status</p>
    <p role="alert">@validation</p>
    @if (Session.Characters.Length > 0)
    {
        <h2>Characters</h2>
        @for (var i = 0; i < Session.Characters.Length; i++)
        {
            var slot = i;
            var name = Session.Characters[slot];
            <button disabled="@(string.IsNullOrWhiteSpace(name))" @onclick="() => Session.SelectCharacter(slot)">
                @(string.IsNullOrWhiteSpace(name) ? "Empty slot" : name)
            </button>
        }
        <button @onclick="Back">Back to main menu</button>
    }
</main>

@code {
    private string username = "";
    private string password = "";
    private string verify = "";
    private string validation = "";
    private string page = "main";
    private readonly CancellationTokenSource cancellation = new();
    private Task? polling;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) polling = PollAsync();
    }
    private void Login() => Authenticate(page == "register");
    private void Back() { password = verify = validation = ""; page = "main"; Session.Disconnect(); }
    private void Authenticate(bool register)
    {
        validation = "";
        if (register && password != verify)
        {
            validation = "Passwords do not match.";
            return;
        }
        Session.Authenticate(username, password, register);
        password = verify = "";
    }
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellation.Token))
                await InvokeAsync(() => { Session.Poll(); StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }
    public async ValueTask DisposeAsync()
    {
        await cancellation.CancelAsync();
        if (polling is not null) await polling;
        cancellation.Dispose();
    }
}
