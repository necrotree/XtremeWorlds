@implements IAsyncDisposable
@inject Client.Blazor.Services.BrowserGameSession Session

<PageTitle>XtremeWorlds Client</PageTitle>
<main class="menu-scene">
  <section class="realm-dialog" aria-label="XtremeWorlds account and character menu">
    <header class="realm-heading">
      <div class="realm-brand"><img class="realm-logo" src="/assets/frmMainMenu/logo.png" alt="XtremeWorlds" /><strong>ENTER THE REALM</strong></div>
      <button class="close-menu" type="button" @onclick="Back" aria-label="Back to main menu"><span class="close-cross" aria-hidden="true"></span></button>
    </header>
    <div class="realm-separator"></div>
    @if (page == "create")
    {
      <form class="realm-form" @onsubmit="CreateCharacter" @onsubmit:preventDefault>
        <h2>Create Character</h2>
        <label>Character name <input @bind="characterName" maxlength="20" required /></label>
        <label>Gender <div class="choice-row"><button type="button" class="@(sex == 0 ? "selected" : "")" @onclick="() => sex = 0">Male</button><button type="button" class="@(sex == 1 ? "selected" : "")" @onclick="() => sex = 1">Female</button></div></label>
        <label>Class <div class="class-grid">
          @for (var i=0;i<classNames.Length;i++) {var choice=i;<button type="button" class="@(selectedClass == choice ? "selected" : "")" @onclick="() => selectedClass = choice">@classNames[choice]</button>}
        </div></label>
        <div class="realm-actions"><button class="primary" type="submit">Create Character</button><button class="secondary" type="button" @onclick='() => page = "characters"'>Cancel</button></div>
      </form>
    }
    else if (Session.Characters.Length > 0)
    {
      <h2>Choose Your Character</h2>
      <div class="character-list">
        @for(var i=0;i<Math.Min(3,Session.Characters.Length);i++){var slot=i;
          <button class="character-entry @(selectedSlot==slot?"selected":"")" aria-pressed="@(selectedSlot==slot)" @onclick="() => selectedSlot=slot">
            <span>Slot @(slot+1)</span><strong>@(string.IsNullOrWhiteSpace(Session.Characters[slot]) ? "Empty Slot" : Session.Characters[slot])</strong>
          </button>
        }
      </div>
      <div class="realm-actions"><button class="primary" disabled="@(!HasCharacter)" @onclick="() => Session.SelectCharacter(selectedSlot)">Enter World</button><button class="secondary" disabled="@(Session.Characters.All(n => !string.IsNullOrWhiteSpace(n)))" @onclick="BeginCreate">New Character</button></div>
      <div class="realm-actions"><button class="secondary" disabled="@(!HasCharacter)" @onclick="() => confirmDelete=true">Delete Character</button><button class="secondary" @onclick="Back">Log Out</button></div>
      @if(confirmDelete)
      {
        <div class="confirm-box" role="alert"><p>Delete @Session.Characters[selectedSlot]?</p>
          <div class="realm-actions"><button class="danger" @onclick="DeleteCharacter">Delete</button><button class="secondary" @onclick="() => confirmDelete=false">Cancel</button></div>
        </div>
      }
    }
    else if (page == "main")
    {
      <p class="intro">Begin your journey in XtremeWorlds.</p>
      <div class="realm-actions"><button class="primary" @onclick='() => page="login"'>Login</button><button class="secondary" @onclick='() => page="register"'>Register</button></div>
    }
    else
    {
      <form class="realm-form" @onsubmit="Login" @onsubmit:preventDefault>
        <label>Account <input @bind="username" autocomplete="username" maxlength="64" required /></label>
        <label>Password <input @bind="password" type="password" autocomplete="@(page=="register"?"new-password":"current-password")" maxlength="128" required /></label>
        @if(page=="register")
        {
          <label>Confirm password <input @bind="verify" type="password" autocomplete="new-password" maxlength="128" required /></label>
        }
        <div class="realm-actions"><button class="primary" type="submit">@(page=="register"?"Register":"Enter")</button><button class="secondary" type="button" @onclick="Back">Cancel</button></div>
      </form>
    }
    <div class="realm-status"><p role="status" aria-live="polite">@Session.Status</p><p role="alert">@validation</p></div>
  </section>
  <a class="realm-website" href="https://www.xtremeworlds.com" target="_blank" rel="noopener">Website</a>
</main>
@code {
    private readonly string[] classNames = ["Fighter", "Wizard", "Celestial", "Guardian", "Assassin"];
    private int selectedSlot, selectedClass, sex;
    private string characterName = "";
    private bool confirmDelete;
    private bool HasCharacter => selectedSlot >= 0 && selectedSlot < Session.Characters.Length && !string.IsNullOrWhiteSpace(Session.Characters[selectedSlot]);
    private void BeginCreate()
    {
        selectedSlot = Array.FindIndex(Session.Characters, string.IsNullOrWhiteSpace);
        if (selectedSlot < 0) return;
        characterName = validation = "";
        page = "create";
    }
    private void CreateCharacter()
    {
        if (Session.CreateCharacter(characterName, sex, selectedClass + 1, selectedSlot)) page = "characters";
    }
    private void DeleteCharacter() { Session.DeleteCharacter(selectedSlot); confirmDelete = false; }
    private string username = "";
    private string password = "";
    private string verify = "";
    private string validation = "";
    private string page = "main";
    private readonly CancellationTokenSource cancellation = new();
    private Task? polling;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) polling = PollAsync();
    }
    private void Login() => Authenticate(page == "register");
    private void Back() { confirmDelete = false; selectedSlot = 0; password = verify = validation = ""; page = "main"; Session.Disconnect(); }
    private void Authenticate(bool register)
    {
        validation = "";
        if (register && password != verify)
        {
            validation = "Passwords do not match.";
            return;
        }
        Session.Authenticate(username, password, register);
        password = verify = "";
    }
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellation.Token))
                await InvokeAsync(() => { Session.Poll(); StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }
    public async ValueTask DisposeAsync()
    {
        await cancellation.CancelAsync();
        if (polling is not null) await polling;
        cancellation.Dispose();
    }
}
