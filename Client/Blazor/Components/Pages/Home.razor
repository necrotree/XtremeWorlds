@page "/"
@inject Client.Blazor.Services.BrowserGameSession Session
@implements IDisposable

@if (Session.InGame)
{
    <Client.Blazor.Components.Forms.FrmMirage />
}
else
{
    <Client.Blazor.Components.Forms.FrmMainMenu />
}

@code {
    protected override void OnInitialized() => Session.Changed += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Session.Changed -= Refresh; Session.Disconnect(); }
}
