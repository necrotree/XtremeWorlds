[FormDesignerId("D5EBE62F-5E4C-4992-B6AB-D5446AE95B23")]
Class frmQuestEditor
    Attribute VB_PredeclaredId = True
    Option Explicit
    Private Names() As String
    Private Count As Long
    Private ClassNames() As String
    Private ClassCount As Long
    Private Current As Long
    Private Busy As Boolean
    Private Saving As Boolean

    Public Sub BeginList(ByVal total As Long)
        If total < 1 Or total > 4096 Then Exit Sub
        Busy = True
        Count = total
        ClassCount = 0
        Saving = False
        ReDim Names(1 To Count)
    End Sub

    Public Sub SetQuestName(ByVal id As Long, ByVal value As String)
        If id >= 1 And id <= Count Then Names(id) = value
    End Sub

    Public Sub SetClassNames(ByRef parts() As String)
        Dim i As Long
        ClassCount = CLng(Val(parts(1)))
        If ClassCount < 1 Or ClassCount > 256 Then ClassCount = 0: Exit Sub
        If UBound(parts) <> ClassCount + 1 Then ClassCount = 0: Exit Sub
        ReDim ClassNames(1 To ClassCount)
        For i = 1 To ClassCount
            ClassNames(i) = parts(i + 1)
        Next i
    End Sub

    Public Sub OpenEditor()
        Dim i As Long
        Busy = True
        cmbQuest.Clear
        cmbNext.Clear
        cmbNext.AddItem "None"
        For i = 1 To Count
            cmbQuest.AddItem CStr(i) & ": " & Names(i)
            cmbNext.AddItem CStr(i) & ": " & Names(i)
        Next i
        cmbNpc.Clear
        cmbNpc.AddItem "Choose an NPC"
        For i = 1 To MAX_NPCS
            cmbNpc.AddItem CStr(i) & ": " & Trim$(Npc(i).name)
        Next i
        cmbClassReq.Clear
        cmbClassReq.AddItem "All classes"
        For i = 1 To ClassCount
            cmbClassReq.AddItem Trim$(ClassNames(i))
        Next i
        cmbItem.Clear
        cmbReward.Clear
        cmbItem.AddItem "None"
        cmbReward.AddItem "None"
        For i = 1 To MAX_ITEMS
            cmbItem.AddItem CStr(i) & ": " & Trim$(Item(i).name)
            cmbReward.AddItem CStr(i) & ": " & Trim$(Item(i).name)
        Next i

        QuestEditorOpen = True
        SafeReleaseGameKeys

        ' Do not pass frmMainGame as an explicit owner here.  The twinBASIC
        ' runtime can fail while constructing a modeless form with that owner.
        Me.Show vbModeless
        Me.ZOrder 0

        cmbQuest.ListIndex = 0
        Busy = False
        cmbQuest_Click
    End Sub

    Private Sub SafeReleaseGameKeys()
        ' ReleaseGameKeys depends on input objects that may not be initialized
        ' while an editor form is being opened or destroyed.  Releasing keys
        ' is best-effort here and must never prevent the editor from opening.
        On Error Resume Next
        ReleaseGameKeys
        Err.Clear
        On Error GoTo 0
    End Sub

    Private Sub cmbQuest_Click()
        If Busy Or cmbQuest.ListIndex < 0 Then Exit Sub
        Current = cmbQuest.ListIndex + 1
        cmdSave.Enabled = False
        lblStatus.Caption = "Loading quest " & Current & "..."
        If IsConnected Then frmMainGame.Socket.SendData "editquestdialogue" & SEP_CHAR & Current & END_CHAR
    End Sub

    Public Sub LoadDefinition(ByRef parts() As String)
        Dim f As Long, value As String
        If CLng(Val(parts(1))) <> Current Then Exit Sub
        Busy = True
        For f = 1 To 19
            value = parts(f + 1)
            Select Case f
                Case 1: txtName.Text = value
                Case 2: cmbNpc.ListIndex = CLng(Val(value))
                Case 3: txtSay.Text = value
                Case 4: txtCompleted.Text = value
                Case 5: txtMissing.Text = value
                Case 6: txtNotReady.Text = value
                Case 7: txtDone.Text = value
                Case 8: cmbClassReq.ListIndex = CLng(Val(value))
                Case 9: txtLevel.Text = CStr(Val(value))
                Case 10: cmbNext.ListIndex = CLng(Val(value))
                Case 11: chkHP.Value = CLng(Val(value))
                Case 12: chkMP.Value = CLng(Val(value))
                Case 13: chkSP.Value = CLng(Val(value))
                Case 14: chkOnce.Value = CLng(Val(value))
                Case 15: cmbItem.ListIndex = CLng(Val(value))
                Case 16: txtItemQty.Text = value
                Case 17: cmbReward.ListIndex = CLng(Val(value))
                Case 18: txtRewardQty.Text = value
                Case 19: txtExp.Text = CStr(Val(value))
            End Select
        Next f
        If Len(txtItemQty.Text) = 0 Then txtItemQty.Text = "1"
        If Len(txtRewardQty.Text) = 0 Then txtRewardQty.Text = "1"
        Busy = False
        cmdSave.Enabled = True
        lblStatus.Caption = "Editing quest " & Current & ". Leave its name blank to disable it."
    End Sub

    Private Function Field(ByVal f As Long) As String
        Select Case f
            Case 1: Field = Trim$(txtName.Text)
            Case 2: Field = CStr(cmbNpc.ListIndex)
            Case 3: Field = txtSay.Text
            Case 4: Field = txtCompleted.Text
            Case 5: Field = txtMissing.Text
            Case 6: Field = txtNotReady.Text
            Case 7: Field = txtDone.Text
            Case 8: Field = CStr(cmbClassReq.ListIndex)
            Case 9: Field = txtLevel.Text
            Case 10: Field = CStr(cmbNext.ListIndex)
            Case 11: Field = CStr(chkHP.Value)
            Case 12: Field = CStr(chkMP.Value)
            Case 13: Field = CStr(chkSP.Value)
            Case 14: Field = CStr(chkOnce.Value)
            Case 15: Field = CStr(cmbItem.ListIndex)
            Case 16: Field = txtItemQty.Text
            Case 17: Field = CStr(cmbReward.ListIndex)
            Case 18: Field = txtRewardQty.Text
            Case 19: Field = txtExp.Text
        End Select
    End Function

    Private Sub cmdSave_Click()
        Dim f As Long, value As String, packet As String
        If Saving Or Current < 1 Or Not IsConnected Then Exit Sub
        packet = "savequestdialogue" & SEP_CHAR & Current
        For f = 1 To 19
            value = Trim$(Field(f))
            If Len(value) > 240 Or InStr(value, SEP_CHAR) > 0 Or InStr(value, END_CHAR) > 0 Or InStr(value, vbCr) > 0 Or InStr(value, vbLf) > 0 Then
                GameMsgBox "Use at most 240 characters per field, without protocol separators or line breaks.", vbExclamation
                Exit Sub
            End If
            If f = 2 Or f >= 8 Then
                If Not IsNumeric(value) Then GameMsgBox "Enter whole numbers for requirements and rewards.", vbExclamation: Exit Sub
                If Val(value) <> Fix(Val(value)) Then GameMsgBox "Enter whole numbers for requirements and rewards.", vbExclamation: Exit Sub
            End If
            packet = packet & SEP_CHAR & value
        Next f
        Saving = True
        cmdSave.Enabled = False
        cmbQuest.Enabled = False
        lblStatus.Caption = "Saving quest " & Current & "..."
        frmMainGame.Socket.SendData packet & END_CHAR
    End Sub

    Public Sub Saved(ByVal id As Long)
        If id <> Current Then Exit Sub
        Names(id) = txtName.Text
        Busy = True
        cmbQuest.List(id - 1) = CStr(id) & ": " & txtName.Text
        cmbNext.List(id) = CStr(id) & ": " & txtName.Text
        Busy = False
        Saving = False
        cmdSave.Enabled = True
        cmbQuest.Enabled = True
        lblStatus.Caption = "Quest " & id & " saved."
    End Sub

    Public Sub SaveFailed(ByVal message As String)
        Saving = False
        cmdSave.Enabled = True
        cmbQuest.Enabled = True
        lblStatus.Caption = message
        GameMsgBox message, vbExclamation, "Quest Editor"
    End Sub

    Private Sub cmdCancel_Click()
        Unload Me
    End Sub

    Private Sub Form_Unload(Cancel As Integer)
        QuestEditorOpen = False
        SafeReleaseGameKeys
    End Sub
End Class
