    Private Sub StretchStatusTexture(ByVal bar As Object)
        Dim texture As StdPicture
        Set texture = bar.Picture
        bar.AutoRedraw = True
        bar.ScaleMode = vbPixels
        Set bar.Picture = Nothing
        bar.Cls
        If Not texture Is Nothing Then bar.PaintPicture texture, 0, 0, bar.ScaleWidth, bar.ScaleHeight
        Set bar.Picture = bar.Image
    End Sub

