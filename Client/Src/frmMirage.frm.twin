    Public Sub UpdateWhoList(ByRef names() As String)
        Dim i As Long, selectedName As String
        If lstWho.ListIndex >= 0 Then selectedName = lstWho.List(lstWho.ListIndex)
        lstWho.Clear
        For i = 1 To UBound(names)
            If Len(Trim$(names(i))) > 0 Then lstWho.AddItem Trim$(names(i))
        Next
        For i = 0 To lstWho.ListCount - 1
            If lstWho.List(i) = selectedName Then lstWho.ListIndex = i
        Next
        If lstWho.ListIndex < 0 And lstWho.ListCount > 0 Then lstWho.ListIndex = 0
    End Sub
    Private Sub lblWhoMessage_Click()
        If lstWho.ListIndex < 0 Then Exit Sub
        MyText = "!" & lstWho.List(lstWho.ListIndex) & " "
        txtMyTextBox.Text = MyText
        txtMyTextBox.SetFocus
        txtMyTextBox.SelStart = Len(MyText)
    End Sub
    Private Sub lblWhoFriend_Click()
        Dim friendName As String, fileName As String
        If lstWho.ListIndex < 0 Then Exit Sub
        friendName = lstWho.List(lstWho.ListIndex)
        fileName = App.Path & DATA_PATH & "Friends.ini"
        PutVar fileName, Trim$(GetPlayerName(MyIndex)), friendName, "1"
        GameMsgBox friendName & " was added to your local friends list.", vbOKOnly, "Friends"
    End Sub
