    Public Sub HandleTilesetMouseWheel(ByVal wheelDelta As Long)
        Dim rowDelta As Long
        Dim newValue As Long

        If Not InEditor Or wheelDelta = 0 Then Exit Sub

        TilesetWheelRemainder = TilesetWheelRemainder + wheelDelta
        rowDelta = TilesetWheelRemainder \ 120
        TilesetWheelRemainder = TilesetWheelRemainder Mod 120
        If rowDelta = 0 Then Exit Sub

        newValue = scrlPicture.Value - rowDelta * scrlPicture.SmallChange
        If newValue < scrlPicture.Min Then newValue = scrlPicture.Min
        If newValue > scrlPicture.Max Then newValue = scrlPicture.Max
        If newValue <> scrlPicture.Value Then scrlPicture.Value = newValue
    End Sub

