    Public Sub LayoutGamePanels()
        Dim sidebar As Single, adminLeft As Single, requiredWidth As Single
        sidebar = 956
        If EditorTileset >= 1 Then scrlTileset.Value = EditorTileset
        picMapEditor.Left = Me.ScaleX(sidebar, vbPixels, Me.ScaleMode)
        picMapEditor.Top = Me.ScaleY(39, vbPixels, Me.ScaleMode)
        adminLeft = sidebar
        requiredWidth = 948
        If picMapEditor.Visible Then
            requiredWidth = sidebar + Me.ScaleX(picMapEditor.Width, Me.ScaleMode, vbPixels) + 8
            adminLeft = requiredWidth
        End If
        Me.Width = Me.Width + Me.ScaleX(requiredWidth - Me.ScaleX(Me.ScaleWidth, Me.ScaleMode, vbPixels), vbPixels, vbTwips)
    End Sub

    Private Sub picWebsite_Click()
        Dim address As String
        address = Trim$(WEBSITE)
        If Len(address) = 0 Then Exit Sub
        If LCase$(Left$(address, 7)) = "http://" Then address = Mid$(address, 8)
        If Left$(address, 2) = "//" Then address = Mid$(address, 3)
        If LCase$(Left$(address, 8)) <> "https://" Then address = "https://" & address
        ShellExecute Me.hWnd, "open", address, vbNullString, vbNullString, 1
    End Sub

    Private Sub picGuild2_Click()
        Dim wasVisible As Boolean
        wasVisible = picGuildPanel.Visible
        CloseSideMenu
        picGuildPanel.Visible = Not wasVisible
        If picGuildPanel.Visible Then RequestGuildDetails
    End Sub

    Public Sub RequestGuildDetails()
        Dim guildId As Long
        If lstGuildMembers.ListIndex >= 0 Then GuildSelectedMember = lstGuildMembers.List(lstGuildMembers.ListIndex)
        lstGuildMembers.Clear
        lblGuildRank.Caption = "Member"
        lblGuildOfficer.Caption = "Officer"
        lblGuildRankRight.Caption = "Leader"
        lblGuildFounderRank.Caption = "Founder"
        lblGuildPromote.Enabled = False
        lblGuildDemote.Enabled = False
        lblGuildMemberDetails.Caption = vbNullString
        lblGuildName.Caption = "No guild"
        If MyIndex < 1 Then Exit Sub
        guildId = GetPlayerGuild(MyIndex)
        If guildId > 0 And guildId <= MAX_GUILDS Then
            lblGuildName.Caption = Trim$(Guild(guildId).name)
        End If
        If InGame Then SendData "guilddetails" & END_CHAR
    End Sub

    Public Sub BeginGuildDetails(ByVal guildName As String, ByVal founder As String)
        If lstGuildMembers.ListIndex >= 0 Then GuildSelectedMember = lstGuildMembers.List(lstGuildMembers.ListIndex)
        lstGuildMembers.Clear
        lblGuildRank.Caption = "Member"
        lblGuildOfficer.Caption = "Officer"
        lblGuildRankRight.Caption = "Leader"
        lblGuildFounderRank.Caption = "Founder"
        lblGuildPromote.Enabled = False
        lblGuildDemote.Enabled = False
        GuildCanChangeRanks = False
        If MyIndex > 0 Then GuildCanChangeRanks = Len(founder) > 0 And StrComp(founder, Trim$(GetPlayerName(MyIndex)), vbTextCompare) = 0
        lblGuildName.Caption = guildName
        lblGuildMemberDetails.Caption = vbNullString
    End Sub

    Public Sub AddGuildMember(ByVal memberName As String, ByVal role As String, ByVal status As String)
        Dim i As Long
        For i = 0 To lstGuildMembers.ListCount - 1
            If StrComp(lstGuildMembers.List(i), memberName, vbTextCompare) = 0 Then Exit Sub
        Next i
        lstGuildMembers.AddItem memberName
        Select Case role
            Case "Officer": lstGuildMembers.ItemData(lstGuildMembers.NewIndex) = 1
            Case "Leader": lstGuildMembers.ItemData(lstGuildMembers.NewIndex) = 2
            Case "Founder": lstGuildMembers.ItemData(lstGuildMembers.NewIndex) = 3
        End Select
        If StrComp(memberName, GuildSelectedMember, vbTextCompare) = 0 Then lstGuildMembers.ListIndex = lstGuildMembers.NewIndex
        If lstGuildMembers.ListIndex < 0 Then lstGuildMembers.ListIndex = 0
        lstGuildMembers_Click
    End Sub

    Private Sub lstGuildMembers_Click()
        lblGuildMemberDetails.Caption = vbNullString
        If lstGuildMembers.ListIndex < 0 Then Exit Sub
        lblGuildMemberDetails.Caption = vbNullString
        Dim ranks(0 To 3) As String, currentRank As Long
        ranks(0) = "Member": ranks(1) = "Officer"
        ranks(2) = "Leader": ranks(3) = "Founder"
        currentRank = lstGuildMembers.ItemData(lstGuildMembers.ListIndex)
        If currentRank >= 0 And currentRank <= 3 Then ranks(currentRank) = "> " & ranks(currentRank)
        lblGuildRank.Caption = ranks(0)
        lblGuildOfficer.Caption = ranks(1)
        lblGuildRankRight.Caption = ranks(2)
        lblGuildFounderRank.Caption = ranks(3)
        lblGuildPromote.Enabled = GuildCanChangeRanks And lstGuildMembers.ItemData(lstGuildMembers.ListIndex) < 2
        lblGuildDemote.Enabled = GuildCanChangeRanks And lstGuildMembers.ItemData(lstGuildMembers.ListIndex) > 0 And lstGuildMembers.ItemData(lstGuildMembers.ListIndex) < 3
    End Sub

    Private Sub ChangeGuildRank(ByVal action As String)
        If Not GuildCanChangeRanks Or lstGuildMembers.ListIndex < 0 Then Exit Sub
        SendData "guildrank" & SEP_CHAR & action & SEP_CHAR & lstGuildMembers.List(lstGuildMembers.ListIndex) & END_CHAR
    End Sub

    Private Sub lblGuildPromote_Click()
        ChangeGuildRank "promote"
    End Sub

    Private Sub lblGuildDemote_Click()
        ChangeGuildRank "demote"
    End Sub

    Private Sub imgInventory_DblClick()
        InventoryDragSlot = 0
        InventoryDragging = False
        If InventoryClickedSlot > 0 Then SendUseItem InventoryClickedSlot
    End Sub

    Public Sub DrawInventoryGrid()
        Dim Bounds As RECT, Source As RECT, Border As RECT
        Dim InventoryBackground As clsDX11Surface
        Dim Cell As Long, Slot As Long, ItemNum As Long, X As Long, Y As Long
        Dim SlotX As Long, SlotY As Long
        If DD_ItemSurf Is Nothing Then Exit Sub
        Set InventoryBackground = InventoryBackgroundPicture()
        If InventoryBackground Is Nothing Then Exit Sub
        If InventoryCanvas Is Nothing Then
            Set InventoryCanvas = New clsDX11Surface
            InventoryCanvas.Create 265, 354
        End If
        Bounds.Right = 265
        Bounds.Bottom = 354
        InventoryCanvas.Blt Bounds, InventoryBackground, Bounds
        For Cell = 0 To 34
            Slot = InventoryPage * 35 + Cell + 1
            If Slot <= MAX_INV Then
                ItemNum = GetPlayerInvItemNum(MyIndex, Slot)
                If ItemNum > 0 And ItemNum <= MAX_ITEMS Then
                    SlotX = 23 + (Cell Mod 5) * 45
                    SlotY = 27 + (Cell \ 5) * 45

                    GetItemPictureRect Item(ItemNum).Pic, Source
                    InventoryCanvas.BltFast SlotX + 3, SlotY + 3, DD_ItemSurf, Source, True

                    Border.Left = SlotX
                    Border.Top = SlotY
                    Border.Right = SlotX + 38
                    Border.Bottom = SlotY + 1
                    InventoryCanvas.BltColorFill Border, RGB(128, 128, 128)

                    Border.Top = SlotY + 37
                    Border.Bottom = SlotY + 38
                    InventoryCanvas.BltColorFill Border, RGB(128, 128, 128)

                    Border.Left = SlotX
                    Border.Top = SlotY + 1
                    Border.Right = SlotX + 1
                    Border.Bottom = SlotY + 37
                    InventoryCanvas.BltColorFill Border, RGB(128, 128, 128)

                    Border.Left = SlotX + 37
                    Border.Right = SlotX + 38
                    InventoryCanvas.BltColorFill Border, RGB(128, 128, 128)
                End If
            End If
        Next Cell

        X = -1: Y = -1
        Cell = lstInv.ListIndex - InventoryPage * 35
        If Cell >= 0 And Cell < 35 Then
            Slot = InventoryPage * 35 + Cell + 1
            If Slot <= MAX_INV Then
                ItemNum = GetPlayerInvItemNum(MyIndex, Slot)
                If ItemNum > 0 And ItemNum <= MAX_ITEMS Then
                    X = 23 + (Cell Mod 5) * 45
                    Y = 27 + (Cell \ 5) * 45
                End If
            End If
        End If
        Set imgInventory.Picture = MenuSurfacePicture(InventoryCanvas, CLng(X), CLng(Y))
    End Sub

    Private Function InventorySlotAt(ByVal X As Single, ByVal Y As Single) As Long
        Dim Column As Long, Row As Long, Slot As Long

        ' Image mouse coordinates can arrive in twips on the classic
        ' twinBASIC form even though the inventory layout is measured
        ' in pixels. Normalize them before doing the grid hit test.
        If X > 265 Or Y > 382 Then
            X = X / Screen.TwipsPerPixelX
            Y = Y / Screen.TwipsPerPixelY
        End If

        X = X - 23
        Y = Y - 27
        If X < 0 Or Y < 0 Or X >= 225 Or Y >= 315 Then Exit Function

        Column = Int(X / 45)
        Row = Int(Y / 45)

        If X - Column * 45 >= 38 Or Y - Row * 45 >= 38 Then Exit Function

        Slot = InventoryPage * 35 + Row * 5 + Column + 1
        If Slot > 0 And Slot <= MAX_INV Then InventorySlotAt = Slot
    End Function

    Private Sub imgInventory_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
        Dim Slot As Long
        InventoryDragSlot = 0
        InventoryDragging = False
        Slot = InventorySlotAt(X, Y)
        InventoryClickedSlot = Slot
        If Slot < 1 Then Exit Sub
        lstInv.ListIndex = Slot - 1
        DrawInventoryGrid
        If Button = vbRightButton Then
            lblDropItem_Click
        ElseIf Button = vbLeftButton Then
            If GetPlayerInvItemNum(MyIndex, Slot) > 0 Then
                InventoryDragSlot = Slot
                InventoryDragX = X
                InventoryDragY = Y
            End If
        End If
    End Sub

    Private Sub imgInventory_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
        Dim destination As Long
        If Button = vbLeftButton And InventoryDragSlot > 0 And InventoryDragging Then
            destination = InventorySlotAt(X, Y)
            If destination > 0 And destination <> InventoryDragSlot Then
                SendData "swapinventory" & SEP_CHAR & InventoryDragSlot & SEP_CHAR & destination & END_CHAR
                lstInv.ListIndex = destination - 1
                DrawInventoryGrid
                InventoryClickedSlot = 0
            End If
        End If
        InventoryDragSlot = 0
        InventoryDragging = False
        imgInventory.MousePointer = vbDefault
    End Sub
    Private Sub imgInventory_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
        Dim Slot As Long
        If (Button And vbLeftButton) <> 0 And InventoryDragSlot > 0 Then
            If Abs(X - InventoryDragX) >= 4 Or Abs(Y - InventoryDragY) >= 4 Then
                InventoryDragging = True
                imgInventory.MousePointer = vbSizeAll
            End If
        Else
            InventoryDragSlot = 0
            InventoryDragging = False
            imgInventory.MousePointer = vbDefault
        End If
        Slot = InventorySlotAt(X, Y)
        imgInventory.ToolTipText = vbNullString
        If Slot > 0 And Slot <= lstInv.ListCount Then imgInventory.ToolTipText = lstInv.List(Slot - 1)
    End Sub

    Private Sub lblInventoryPrevious_Click()
        If InventoryPage > 0 Then
            InventoryPage = InventoryPage - 1
            lstInv.ListIndex = InventoryPage * 35
            DrawInventoryGrid
        End If
    End Sub

    Private Sub lblInventoryNext_Click()
        If (InventoryPage + 1) * 35 < MAX_INV Then
            InventoryPage = InventoryPage + 1
            lstInv.ListIndex = InventoryPage * 35
            DrawInventoryGrid
        End If
    End Sub

    Private Sub lstInv_Click()
        If lstInv.ListIndex < 0 Then Exit Sub
        InventoryPage = lstInv.ListIndex \ 35
        DrawInventoryGrid
    End Sub
    Public Sub RefreshCharacterDetails()
        If MyIndex < 1 Then Exit Sub
        lblCharacterValue(0).Caption = Trim$(Class(GetPlayerClass(MyIndex)).Name)
        lblCharacterValue(1).Caption = CStr(GetPlayerLevel(MyIndex))
        lblCharacterValue(2).Caption = "None"
        If GetPlayerGuild(MyIndex) > 0 Then lblCharacterValue(2).Caption = CStr(GetPlayerGuild(MyIndex))
        lblCharacterValue(3).Caption = GetPlayerHP(MyIndex) & " / " & GetPlayerMaxHP(MyIndex)
        lblCharacterValue(4).Caption = GetPlayerMP(MyIndex) & " / " & GetPlayerMaxMP(MyIndex)
        lblCharacterValue(5).Caption = GetPlayerExp(MyIndex) & " / " & GetPlayerNextLevel(MyIndex)
        lblCharacterValue(6).Caption = ChrW$(&H2014)
        lblCharacterValue(7).Caption = CStr(GetPlayerPOINTS(MyIndex))
        lblCharacterValue(8).Caption = CStr(GetPlayerSTR(MyIndex))
        lblCharacterValue(9).Caption = CStr(GetPlayerDEF(MyIndex))
        lblCharacterValue(9).ToolTipText = "Defense"
        lblCharacterValue(10).Caption = GetPlayerSP(MyIndex) & " / " & GetPlayerMaxSP(MyIndex)
        lblCharacterValue(11).Caption = CStr(GetPlayerSPEED(MyIndex))
        lblCharacterValue(11).ToolTipText = "Speed"
        lblCharacterValue(12).Caption = CStr(GetPlayerMAGI(MyIndex))
        lblCharacterValue(12).ToolTipText = "Magic"
        lblCharacterValue(13).Caption = ChrW$(&H2014)
        lblCharacterValue(6).ToolTipText = "Not tracked by this game"
        lblCharacterValue(13).ToolTipText = "Not tracked by this game"
        Dim TrainColor As Long
        If GetPlayerPOINTS(MyIndex) > 0 Then
            TrainColor = RGB(80, 220, 80)
        Else
            TrainColor = RGB(80, 220, 80)
        End If
        Dim statButton As Long
        For statButton = 0 To 3
            lblCharacterTrain(statButton).Enabled = (GetPlayerPOINTS(MyIndex) > 0)
            lblCharacterTrain(statButton).ZOrder 0
        Next
        lblCharacterTrain(0).Caption = "+"
        lblCharacterTrain(1).Caption = "+"
        lblCharacterTrain(2).Caption = "+"
        lblCharacterTrain(3).Caption = "+"
        lblCharacterTrain(0).ForeColor = TrainColor
        lblCharacterTrain(1).ForeColor = TrainColor
        lblCharacterTrain(2).ForeColor = TrainColor
        lblCharacterTrain(3).ForeColor = TrainColor
    End Sub
    
    Public Sub RefreshSkills()
        Dim Page As Long, i As Long, Slot As Long, Num As Long
        Dim Canvas As New clsDX11Surface, Bounds As RECT, Source As RECT
        If lstSpells.ListIndex < 0 Or lstSpells.ListIndex >= MAX_PLAYER_SPELLS Then Exit Sub
        Page = lstSpells.ListIndex \ 8
        Canvas.Create 32, 32
        Bounds.Right = 32
        Bounds.Bottom = 32
        For i = 0 To 7
            Slot = Page * 8 + i
            Num = 0
            If Slot < MAX_PLAYER_SPELLS Then Num = Player(MyIndex).Spell(Slot)
            lblSkillName(i).Caption = "Empty"
            lblSkillName(i).ForeColor = RGB(220, 205, 180)
            Canvas.BltColorFill Bounds, RGB(102, 51, 51)
            If Num > 0 And Num <= MAX_SPELLS Then
                lblSkillName(i).Caption = Trim$(Spell(Num).name)
                If LenB(lblSkillName(i).Caption) = 0 Then lblSkillName(i).Caption = "Spell #" & Num & " (undefined)"
                If Not DD_SpellSurf Is Nothing Then
                    Source.Left = PIC_X
                    Source.Top = Spell(Num).Graphic * PIC_Y
                    Source.Right = Source.Left + PIC_X
                    Source.Bottom = Source.Top + PIC_Y
                    If Source.Top >= 0 And Source.Bottom <= DD_SpellSurf.Height Then Canvas.BltFast 0, 0, DD_SpellSurf, Source, True
                End If
            End If
            If Slot = lstSpells.ListIndex Then lblSkillName(i).ForeColor = RGB(255, 230, 120)
            imgSkillIcon(i).ToolTipText = (Slot + 1) & ": " & lblSkillName(i).Caption
            Set imgSkillIcon(i).Picture = MenuSurfacePicture(Canvas)
        Next i
        Num = Player(MyIndex).Spell(lstSpells.ListIndex)
        lblSkillsDetails.Caption = "Empty spell slot."
        If Num > 0 And Num <= MAX_SPELLS Then
            lblSkillsDetails.Caption = Trim$(Spell(Num).name) & vbCrLf & vbCrLf & "Level: " & Spell(Num).LevelReq & vbCrLf & "Mana: " & Spell(Num).MPReq & vbCrLf & vbCrLf & "Double-click to memorize."
        End If
    End Sub

