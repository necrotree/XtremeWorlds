    Public Sub DisplayBookPages(ByVal Id As Long, ByVal Page As Long, ByVal Total As Long, ByVal Title As String, ByVal LeftPage As String, ByVal RightPage As String)
        CurrentBookId = Id
        CurrentBookPage = Page
        CurrentBookTotal = Total
        If BookBackground Is Nothing Then
            Set BookBackground = New clsDX11Surface
            BookBackground.LoadFromFile App.Path & GFX_PATH & "gui\book.png"
            Set imgBook.Picture = MenuSurfacePicture(BookBackground)
        End If
        imgBook.ZOrder 1
        lblBookTitle.Caption = Title
        txtBookLeft.Text = LeftPage
        txtBookRight.Text = RightPage
        lblBookPages.Caption = "Page " & Page & " of " & Total
        If Page < Total Then lblBookPages.Caption = "Pages " & Page & "-" & (Page + 1) & " of " & Total
        cmdBookPrevious.Enabled = Page > 1
        cmdBookNext.Enabled = (Page + 1 < Total Or LinkedBookId > 0)
        picBook.Visible = True
        picBook.ZOrder 0
    End Sub

    Private Sub cmdBookPrevious_Click()
        RequestBookPages CurrentBookPage - 2
    End Sub
    Private Sub cmdBookNext_Click()
        If LinkedBookId > 0 And CurrentBookPage + 2 > CurrentBookTotal Then
            SendData "readbook" & SEP_CHAR & LinkedBookId & SEP_CHAR & 1 & END_CHAR
        Else
            RequestBookPages CurrentBookPage + 2
        End If
    End Sub
    Private Sub cmdBookClose_Click()
        picBook.Visible = False
        If BookPreviewOpen Then frmBookEditor.ReturnFromPreview: Exit Sub
        SetFocusOnGame
    End Sub
    Private Sub RequestBookPages(ByVal Page As Long)
        If Not IsConnected Then
            picBook.Visible = False
            Exit Sub
        End If
        SendData "readbook" & SEP_CHAR & CurrentBookId & SEP_CHAR & Page & END_CHAR
    End Sub
End Class
