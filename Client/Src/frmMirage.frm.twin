    Private Sub EmptyGearSlot(ByVal Slot As Byte)
    Dim strSlot As String
    
        Select Case Slot
            Case 0
                strSlot = "Shield"
            Case 1
                strSlot = "Armor"
            Case 2
                strSlot = "Weapon"
            Case 3
                strSlot = "Helmet"
        End Select
        
        lblGearName.Caption = "No " & strSlot & " equipped."
        lblGearDur.Caption = vbNullString
        lblGearStr.Caption = vbNullString
        
    End Sub
    
