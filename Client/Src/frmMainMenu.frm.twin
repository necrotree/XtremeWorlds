    Public Sub HideMenuPanels()
        imgMainMenu.Visible = False
        picLogin.Visible = False
        picRegister.Visible = False
        SetMenuVisible "mnuClassSelection", False
        SetMenuVisible "mnuLogin", False
        SetMenuVisible "mnuNewAccount", False
        SetMenuVisible "mnuNewCharacter", False
        SetMenuVisible "mnuChars", False
    End Sub

    Private Sub picWebsite_Click()
        Dim address As String
        address = Trim$(WEBSITE)
        If Len(address) = 0 Then
            GameMsgBox "The server has not supplied a website address yet.", vbInformation, GAME_NAME
            Exit Sub
        End If
        ' Preserve an explicit http:// or https:// URL from the server.
        ' The previous code stripped http:// and forced https://, which broke
        ' sites that intentionally use HTTP or redirect differently.
        If Left$(address, 2) = "//" Then
            address = "https:" & address
        ElseIf LCase$(Left$(address, 7)) <> "http://" And LCase$(Left$(address, 8)) <> "https://" Then
            address = "https://" & address
        End If
        ShellExecute Me.hWnd, "open", address, vbNullString, vbNullString, 1
    End Sub

    Private Sub txtNewAcctVerify_KeyPress(KeyAscii As Integer)
