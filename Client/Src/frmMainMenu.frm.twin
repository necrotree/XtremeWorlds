    ' New Character Subs
    
    ' The New Character Sprite Timer
    
    ' Fetch public server metadata without waiting for a login or blocking the UI.
    Public Sub RefreshWebsite()
        On Error GoTo Unavailable
        timerSprite.Enabled = False
        If IsConnected Then
            GetGameSite
            Exit Sub
        End If
        mWebsitePolls = 0
        With frmMainGame.Socket
            If .State = 0 Or .State = 9 Then .Connect
        End With
        timerSprite.Interval = 100
        timerSprite.Enabled = True
        Exit Sub
Unavailable:
        timerSprite.Enabled = False
    End Sub

    Private Sub timerSprite_Timer()
        If IsConnected Then
            timerSprite.Enabled = False
            GetGameSite
        Else
            mWebsitePolls = mWebsitePolls + 1
            If mWebsitePolls >= 50 Or frmMainGame.Socket.State = 9 Or frmMainGame.Socket.State = 0 Then
                timerSprite.Enabled = False
            End If
        End If
    End Sub
    
