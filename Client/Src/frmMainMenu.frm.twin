    Private mWebsitePolls As Long
    
    Private Sub Form_Load()
        Dim FileName As String
        Me.KeyPreview = True
        If App.PrevInstance = True Then
            GameMsgBox "Another client is already running! Please run only one client at a time!", Error
        End If
    
        FileName = App.Path & DATA_PATH & "Data.dat"
        WEBSITE = Trim$(GetVar(App.Path & "\options.ini", "Options", "Website"))
        If Len(WEBSITE) = 0 Then
            WEBSITE = "https://xtremeworlds.com"
            PutVar App.Path & "\options.ini", "Options", "Website", WEBSITE
        End If
        InitializeMenuImages
        ShowMenuHome
    End Sub
    
