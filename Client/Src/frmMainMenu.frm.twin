    Public Sub ShowClassSelection()
        CurrentClass = 1
        HideMenuPanels
        SetMenuVisible "mnuClassSelection", True
        picClassContinue.ZOrder 0
        picClassBack.ZOrder 0
        RefreshSelectedClass
    End Sub

    Private Sub RefreshSelectedClass()
        lblSelectedClass.Caption = Trim$(Class(CurrentClass).Name)
        picFemale.Enabled = (Class(CurrentClass).MSprite <> Class(CurrentClass).FSprite)
        NewCharBltSprite CurrentClass
    End Sub

    Private Sub ChooseNamedClass(ByVal className As String)
        Dim i As Long
        For i = 1 To MAX_CLASS
            If StrComp(Trim$(Class(i).Name), className, vbTextCompare) = 0 Then
                CurrentClass = i
                RefreshSelectedClass
                picClassContinue_Click
                Exit Sub
            End If
        Next
    End Sub

