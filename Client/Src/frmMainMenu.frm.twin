    Private Sub picNewAcctConnect_Click()
        If txtNewAcctPassword.Text <> txtNewAcctVerify.Text Then
            GameMsgBox "Passwords do not match.", vbExclamation, GAME_NAME
            txtNewAcctVerify.SetFocus
            Exit Sub
        End If
        Call NewAccountConnect
    End Sub
    
