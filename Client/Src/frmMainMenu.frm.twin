    End Sub

    Private Sub InitializeMenuImages()
        imgBackground.ZOrder 1
        imgMainMenu.ZOrder 1
        imgBackground.ZOrder 1
        imgLogin.ZOrder 1
        imgRegister.ZOrder 1
        imgCharacters.ZOrder 1
        imgNewChar.ZOrder 1
        imgClassSelection.ZOrder 1
    End Sub

