    End Sub

    ' Image controls are not containers. Tags group the flat Image, Label,
    ' and input controls so every menu changes visibility as one unit.
    Public Sub SetMenuVisible(ByVal menuName As String, ByVal showMenu As Boolean)
        Dim control As Object, prefix As String, imageName As String
        prefix = "menu:" & menuName & ":"
        Select Case menuName
            Case "mnuLogin": imageName = "imgLogin"
            Case "mnuNewAccount": imageName = "imgRegister"
            Case "mnuChars": imageName = "imgCharacters"
            Case "mnuNewCharacter": imageName = "imgNewChar"
            Case "mnuClassSelection": imageName = "imgClassSelection"
            Case Else: Exit Sub
        End Select
        If showMenu Then Me.Controls(imageName).ZOrder 0
        For Each control In Me.Controls
            If Left$(CStr(control.Tag), Len(prefix)) = prefix Then
                control.Visible = showMenu And (CStr(control.Tag) = prefix & "show")
                If control.Visible And control.Name <> imageName Then control.ZOrder 0
            End If
        Next
    End Sub

    Private Sub lblMale_Click()
        CurrentSex = 1
        NewCharBltSprite(CurrentClass)
    End Sub
    
    Private Sub lblFemale_Click()
        CurrentSex = 0
        NewCharBltSprite(CurrentClass)
