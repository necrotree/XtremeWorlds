    Private Sub picDeleteAccount_Click()
    ' Dim YesNo As Long
    
    ' YesNo = MsgBox("You are on the path for a character deletion, are you sure you want to go through with this?", vbYesNo, GAME_NAME)
    ' If YesNo = vbYes Then
    ' frmDeleteAccount.Visible = True
    ' Me.Visible = False
    ' End If
    End Sub
    
    ' Exit Game Subs
    
    Private Sub picQuit_Click()
        Call StopMidi
        Call GameDestroy
    End Sub
    
    ' New Character Subs
    
    ' The New Character Sprite Timer
    
    Private Sub timerSprite_Timer()
    ' Call NewCharBltSprite(cmbClass.ListIndex)
    End Sub
    
    Private Sub optFemale_Click()
        Call NewCharBltSprite(cmbClass.ListIndex)
    End Sub
    
    Private Sub optMale_Click()
        Call NewCharBltSprite(cmbClass.ListIndex)
    End Sub
    
    Private Sub picNewCharAddChar_Click()
        Call AddCharClick
    End Sub
    
    Private Sub picNewCharCancel_Click()
        mnuChars.Visible = True
        mnuNewCharacter.Visible = False
    End Sub
    
    Private Sub cmbClass_Change()
        If cmbClass.ListIndex < 0 Then Exit Sub
        Call NewCharBltSprite(cmbClass.ListIndex)
        If Class(cmbClass.ListIndex).Sprite = Class(cmbClass.ListIndex).FSprite Then
            optMale.Value = True
            optMale.Visible = False
            optFemale.Value = False
            optFemale.Visible = False
        ElseIf Class(cmbClass.ListIndex).Sprite <> Class(cmbClass.ListIndex).FSprite Then
            optMale.Value = True
            optMale.Visible = False
            optFemale.Value = False
            optFemale.Visible = False
        End If
    End Sub
    
    Private Sub cmbClass_Click()
        If cmbClass.ListIndex < 0 Then Exit Sub
        lblHP.Caption = Str(Class(cmbClass.ListIndex).HP)
        lblMP.Caption = Str(Class(cmbClass.ListIndex).MP)
        lblSP.Caption = Str(Class(cmbClass.ListIndex).SP)
    
        lblSTR.Caption = Str(Class(cmbClass.ListIndex).STR)
        lblDEF.Caption = Str(Class(cmbClass.ListIndex).DEF)
        lblSPEED.Caption = Str(Class(cmbClass.ListIndex).speed)
        lblMAGI.Caption = Str(Class(cmbClass.ListIndex).MAGI)
        Call NewCharBltSprite(cmbClass.ListIndex)
    End Sub
    
    ' Character Subs
    
    Private Sub picUseChar_Click()
        Call StopMidi
        Call MenuState(MENU_STATE_USECHAR)
    End Sub
    
    Private Sub picNewChar_Click()
        Call MenuState(MENU_STATE_NEWCHAR)
    End Sub
    
    Private Sub picCharsCancel_Click()
        Call TcpDestroy
        HideMenuPanels
        mnuLogin.Visible = True
        mnuLogin.ZOrder 0
        mnuChars.Visible = False
    End Sub
    
    Private Sub picDelChar_Click()
        Dim Value As Long
    
        Value = MsgBox("Are you sure you wish to delete this character?", vbYesNo, GAME_NAME)
        If Value = vbYes Then
            Call MenuState(MENU_STATE_DELCHAR)
        End If
    End Sub
    

    Public Sub HideMenuPanels()
        mnuLogin.Visible = False
        mnuNewAccount.Visible = False
        mnuNewCharacter.Visible = False
        mnuChars.Visible = False
    End Sub

    Private Sub picWebsite_Click()
        Dim address As String
        address = Trim$(WEBSITE)
        If Len(address) = 0 Then
            MsgBox "The server has not supplied a website address yet.", vbInformation, GAME_NAME
            Exit Sub
        End If
        If LCase$(Left$(address, 7)) <> "http://" And LCase$(Left$(address, 8)) <> "https://" Then address = "https://" & address
        ShellExecute Me.hWnd, "open", address, vbNullString, vbNullString, 1
    End Sub

    Private Sub txtNewAcctVerify_KeyPress(KeyAscii As Integer)
        If KeyAscii = 13 Then
            KeyAscii = 0
            picNewAcctConnect_Click
        End If
    End Sub

    Private Sub picPreviousClass_Click()
        If cmbClass.ListCount = 0 Then Exit Sub
        cmbClass.ListIndex = (cmbClass.ListIndex + cmbClass.ListCount - 1) Mod cmbClass.ListCount
    End Sub

    Private Sub picNextClass_Click()
        If cmbClass.ListCount = 0 Then Exit Sub
        cmbClass.ListIndex = (cmbClass.ListIndex + 1) Mod cmbClass.ListCount
    End Sub

    Private Sub picMale_Click()
        optMale.Value = True
    End Sub

    Private Sub picFemale_Click()
        optFemale.Value = True
    End Sub

    Public Sub SetCharacterSlot(ByVal slot As Long, ByVal name As String, ByVal sprite As Long)
        Dim preview As Object, label As Object
        Dim source As RECT, destination As RECT
        If slot < 0 Or slot > 2 Then Exit Sub
        Set preview = Me.Controls("picCharacter" & slot)
        Set label = Me.Controls("lblCharacter" & slot)
        label.Caption = name
        If Len(name) = 0 Then label.Caption = "Empty"
        label.ToolTipText = label.Caption
        mCharacterSprites(slot) = sprite
        preview.Cls
        If Len(name) = 0 Or DD_SpriteSurf Is Nothing Then Exit Sub
        If sprite < 0 Or (sprite + 1) * PIC_Y > DD_SpriteSurf.Height Then Exit Sub
        source.Left = 3 * PIC_X
        source.Top = sprite * PIC_Y
        source.Right = source.Left + PIC_X
        source.Bottom = source.Top + PIC_Y
        destination.Left = 8: destination.Top = 8
        destination.Right = 40: destination.Bottom = 40
        DD_SpriteSurf.BltToDC preview.hDC, source, destination
        preview.Refresh
    End Sub

    Public Sub SelectCharacterSlot(ByVal slot As Long)
        Dim i As Long, label As Object
        If slot < 0 Or slot >= lstChars.ListCount Then Exit Sub
        lstChars.ListIndex = slot
        For i = 0 To 2
            Set label = Me.Controls("lblCharacter" & i)
            label.ForeColor = RGB(191, 205, 128)
            label.FontBold = (i = slot)
            If i = slot Then label.ForeColor = vbWhite
        Next
    End Sub

    Private Sub picCharacter0_Click()
        SelectCharacterSlot 0
    End Sub
    Private Sub picCharacter1_Click()
        SelectCharacterSlot 1
    End Sub
    Private Sub picCharacter2_Click()
        SelectCharacterSlot 2
    End Sub
    Private Sub lblCharacter0_Click()
        SelectCharacterSlot 0
    End Sub
    Private Sub lblCharacter1_Click()
        SelectCharacterSlot 1
    End Sub
    Private Sub lblCharacter2_Click()
        SelectCharacterSlot 2
    End Sub

End Class
