[FormDesignerId("296D7561-D324-4351-93D4-305C9206FEA0")]
Class frmBookEditor
    Attribute VB_PredeclaredId = True
    Option Explicit

    Private Current As Long
    Private Saving As Boolean
    Private QuestIds(0 To 32767) As Long
    Private BookCount As Long
    Private QuestCount As Long
    Private Initialized As Boolean

    Public Sub BeginList(ByVal maximum As Long)
        Initialized = False
        BookCount = 0
        QuestCount = 0
        MAX_BOOKS = maximum
        ReDim Book(1 To MAX_BOOKS) As BookRec
        QuestIds(0) = 0
        Current = 0
        Saving = False

        cmbBook.Clear
        cmbQuest.Clear

        cmbBook.AddItem "None"
        cmbQuest.AddItem "None"

        cmbBook.ListIndex = 0
        cmbQuest.ListIndex = 0

        cmdOk.Enabled = False
        cmdPreview.Enabled = False

        Initialized = True
    End Sub

    Public Sub AddBook(ByVal id As Long, ByVal title As String)
        If Not Initialized Then Exit Sub
        If id < 1 Or id > MAX_BOOKS Then Exit Sub
        ' Server sends every slot in order, matching the shared index editor.
        If id <= BookCount Then Exit Sub
        If id <> BookCount + 1 Then Exit Sub
        SetBookName Book(id), title
        cmbBook.AddItem CStr(id) & ": " & title
        BookCount = id
    End Sub

    Private Sub SetBookName(ByRef value As BookRec, ByVal title As String)
        value.Name = title
    End Sub

    Public Sub AddQuest(ByVal id As Long, ByVal title As String)
        Dim i As Long

        If Not Initialized Then Exit Sub
        If QuestCount >= 32767 Then Exit Sub

        For i = 0 To QuestCount
            If QuestIds(i) = id Then Exit Sub
        Next i

        cmbQuest.AddItem CStr(id) & ": " & title

        QuestCount = QuestCount + 1
        QuestIds(QuestCount) = id
    End Sub

    Private Sub SelectBook(ByVal id As Long)
        cmbBook.ListIndex = 0
        If id >= 1 And id <= BookCount Then cmbBook.ListIndex = id
    End Sub

    Private Sub SelectQuest(ByVal id As Long)
        Dim i As Long

        cmbQuest.ListIndex = 0

        For i = 0 To QuestCount
            If QuestIds(i) = id Then
                cmbQuest.ListIndex = i
                Exit Sub
            End If
        Next i
    End Sub

    Public Sub FillIndex(ByVal list As Object)
        Dim i As Long
        list.Clear
        For i = 1 To BookCount
            list.AddItem cmbBook.List(i)
        Next i
        If list.ListCount > 0 Then list.ListIndex = 0
    End Sub

    Public Sub SelectBookForEdit(ByVal id As Long)
        If id < 1 Or id > BookCount Then Exit Sub
        Current = id
    End Sub

    Public Sub OpenEditor()
        Saving = False
        BookEditorOpen = True
        InBookEditor = True
        ReleaseGameKeys

        ' Like item/quest editors, choose a content slot first.
        FillIndex frmIndex.lstIndex
        frmIndex.Show vbModeless, frmMainGame
        frmIndex.ZOrder 0
    End Sub

    Public Sub LoadDefinition(ByRef parts() As String)

        If Not Initialized Then Exit Sub
        If Not BookEditorOpen Then Exit Sub
        If Current < 1 Or Current > BookCount Then Exit Sub
        If CLng(Val(parts(1))) <> Current Then Exit Sub

        LoadBookRecord Book(Current), parts

        cmdOk.Enabled = True
        cmdPreview.Enabled = True

        Me.Show vbModeless, frmMainGame
        Me.ZOrder 0
    End Sub

    Private Sub LoadBookRecord(ByRef value As BookRec, ByRef parts() As String)
        value.Name = parts(2)
        value.Header = parts(3)
        value.Pages(1) = parts(4)
        value.Pages(2) = parts(5)
        value.PageCount = 2
        value.NextBook = CLng(Val(parts(6)))
        value.Quest = CLng(Val(parts(7)))
        txtBookTitle.Text = RTrim$(value.Name)
        txtBookHeader.Text = RTrim$(value.Header)
        txtPage1.Text = RTrim$(value.Pages(1))
        txtPage2.Text = RTrim$(value.Pages(2))
        SelectBook value.NextBook
        SelectQuest value.Quest
    End Sub

    Private Sub StoreBookRecord(ByRef value As BookRec)
        value.Name = CleanBookEditorText(txtBookTitle.Text)
        value.Header = CleanBookEditorText(txtBookHeader.Text)
        value.Pages(1) = CleanBookEditorText(txtPage1.Text)
        value.Pages(2) = CleanBookEditorText(txtPage2.Text)
        value.NextBook = cmbBook.ListIndex
        value.Quest = QuestIds(cmbQuest.ListIndex)
    End Sub

    Private Sub SendBookRecord(ByRef value As BookRec)
        frmMainGame.Socket.SendData "savebook" & SEP_CHAR & Current & SEP_CHAR & RTrim$(value.Name) & SEP_CHAR & RTrim$(value.Header) & SEP_CHAR & RTrim$(value.Pages(1)) & SEP_CHAR & RTrim$(value.Pages(2)) & SEP_CHAR & value.NextBook & SEP_CHAR & value.Quest & END_CHAR
    End Sub

    Private Function CleanBookEditorText(ByVal value As String) As String
        value = Replace(value, SEP_CHAR, " ")
        value = Replace(value, END_CHAR, " ")
        CleanBookEditorText = value
    End Function

    Private Sub cmdOk_Click()
        If Saving Then Exit Sub
        If Current < 1 Then Exit Sub
        If Not IsConnected Then Exit Sub

        If cmbBook.ListIndex < 0 Then Exit Sub
        If cmbQuest.ListIndex < 0 Then Exit Sub

        If cmbBook.ListIndex = Current Then
            GameMsgBox "Choose a different connecting book.", vbExclamation
            Exit Sub
        End If

        Saving = True

        cmdOk.Enabled = False
        StoreBookRecord Book(Current)
        SendBookRecord Book(Current)
    End Sub

    Public Sub Saved(ByVal id As Long)
        If id <> Current Then Exit Sub

        Saving = False
        If id >= 1 And id <= BookCount Then
            cmbBook.List(id) = CStr(id) & ": " & txtBookTitle.Text
        End If
        CloseToIndex
    End Sub

    Public Sub SaveFailed(ByVal message As String)
        Saving = False
        cmdOk.Enabled = (Current >= 1 And Current <= BookCount)
        ' Display load/save errors, but otherwise leave the editor alone.
        GameMsgBox message, vbExclamation, "Book Editor"
    End Sub

    Private Sub cmdPreview_Click()
        Dim title As String

        title = txtBookHeader.Text

        If Len(title) = 0 Then
            title = txtBookTitle.Text
        End If

        StoreBookRecord Book(Current)
        LinkedBookId = 0
        BookPreviewOpen = True

        frmMainGame.DisplayBookPages Current, 1, 2, title, txtPage1.Text, txtPage2.Text

        Me.Hide

        BookEditorOpen = False

        ReleaseGameKeys
    End Sub

    Public Sub ReturnFromPreview()
        BookPreviewOpen = False
        BookEditorOpen = True

        Me.Show vbModeless, frmMainGame
        Me.ZOrder 0
    End Sub

    Private Sub cmdCancel_Click()
        CloseToIndex
    End Sub

    Private Sub CloseToIndex()
        Dim showIndex As Boolean
        showIndex = IsConnected And InGame

        If showIndex Then
            InBookEditor = True
            FillIndex frmIndex.lstIndex
            If Current >= 1 And Current <= frmIndex.lstIndex.ListCount Then frmIndex.lstIndex.ListIndex = Current - 1
            frmIndex.Show vbModeless, frmMainGame
            frmIndex.ZOrder 0
        End If

        BookEditorOpen = False
        BookPreviewOpen = False
        Unload Me
    End Sub

    Private Sub Form_Unload(Cancel As Integer)
        If Saving Then
            Cancel = 1
            Exit Sub
        End If

        BookEditorOpen = False
        BookPreviewOpen = False
        InBookEditor = False

        ReleaseGameKeys
    End Sub
End Class