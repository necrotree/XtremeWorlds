[FormDesignerId("9B637F03-73F7-41AF-A510-EDE7E5F8CB29")]
Class frmBookEditor
    Attribute VB_PredeclaredId = True
    Option Explicit

    Private Current As Long
    Private Saving As Boolean
    Private BookIds(0 To 32767) As Long
    Private QuestIds(0 To 32767) As Long
    Private BookCount As Long
    Private QuestCount As Long
    Private Initialized As Boolean

    Public Sub BeginList()
        Initialized = False
        BookCount = 0
        QuestCount = 0
        BookIds(0) = 0
        QuestIds(0) = 0
        Current = 0
        Saving = False

        cmbBook.Clear
        cmbQuest.Clear

        cmbBook.AddItem "None"
        cmbQuest.AddItem "None"

        cmbBook.ListIndex = 0
        cmbQuest.ListIndex = 0

        cmdOk.Enabled = False
        cmdPreview.Enabled = False

        Initialized = True
    End Sub

    Public Sub AddBook(ByVal id As Long, ByVal title As String)
        Dim i As Long

        If Not Initialized Then Exit Sub
        If BookCount >= 32767 Then Exit Sub

        For i = 0 To BookCount
            If BookIds(i) = id Then Exit Sub
        Next i

        cmbBook.AddItem CStr(id) & ": " & title

        BookCount = BookCount + 1
        BookIds(BookCount) = id
    End Sub

    Public Sub AddQuest(ByVal id As Long, ByVal title As String)
        Dim i As Long

        If Not Initialized Then Exit Sub
        If QuestCount >= 32767 Then Exit Sub

        For i = 0 To QuestCount
            If QuestIds(i) = id Then Exit Sub
        Next i

        cmbQuest.AddItem CStr(id) & ": " & title

        QuestCount = QuestCount + 1
        QuestIds(QuestCount) = id
    End Sub

    Private Sub SelectBook(ByVal id As Long)
        Dim i As Long

        cmbBook.ListIndex = 0

        For i = 0 To BookCount
            If BookIds(i) = id Then
                cmbBook.ListIndex = i
                Exit Sub
            End If
        Next i
    End Sub

    Private Sub SelectQuest(ByVal id As Long)
        Dim i As Long

        cmbQuest.ListIndex = 0

        For i = 0 To QuestCount
            If QuestIds(i) = id Then
                cmbQuest.ListIndex = i
                Exit Sub
            End If
        Next i
    End Sub

    Public Sub OpenEditor()
        Current = 0
        Saving = False
        BookEditorOpen = True

        ReleaseGameKeys

        txtId.Text = "1"
        cmdLoad.Enabled = True
        cmdOk.Enabled = False
        cmdPreview.Enabled = False

        cmdLoad_Click
    End Sub

    Private Sub cmdLoad_Click()
        If Saving Then Exit Sub
        If Not IsConnected Then Exit Sub
        If Not IsNumeric(txtId.Text) Then Exit Sub
        If Val(txtId.Text) < 1 Then Exit Sub
        If Val(txtId.Text) > 32767 Then Exit Sub
        If Val(txtId.Text) <> Fix(Val(txtId.Text)) Then Exit Sub

        Current = CLng(txtId.Text)

        cmdOk.Enabled = False
        cmdPreview.Enabled = False

        lblStatus.Caption = "Loading book " & Current & "..."

        frmMainGame.Socket.SendData "editbook" & SEP_CHAR & Current & END_CHAR
    End Sub

    Public Sub LoadDefinition(ByRef parts() As String)
        Dim bookId As Long
        Dim questId As Long

        If Not Initialized Then Exit Sub
        If Not BookEditorOpen Then Exit Sub
        If CLng(Val(parts(1))) <> Current Then Exit Sub

        txtBookTitle.Text = DecodeBookText(parts(2))
        txtBookHeader.Text = DecodeBookText(parts(3))
        txtPage1.Text = DecodeBookText(parts(4))
        txtPage2.Text = DecodeBookText(parts(5))

        bookId = CLng(Val(parts(6)))
        questId = CLng(Val(parts(7)))

        SelectBook bookId
        SelectQuest questId

        cmdOk.Enabled = True
        cmdPreview.Enabled = True

        lblStatus.Caption = "Editing book " & Current & ". Additional imported pages are preserved."
    End Sub

    Private Sub cmdOk_Click()
        If Saving Then Exit Sub
        If Current < 1 Then Exit Sub
        If Not IsConnected Then Exit Sub

        If cmbBook.ListIndex < 0 Then Exit Sub
        If cmbQuest.ListIndex < 0 Then Exit Sub

        If BookIds(cmbBook.ListIndex) = Current Then
            GameMsgBox "Choose a different connecting book.", vbExclamation
            Exit Sub
        End If

        Saving = True

        cmdOk.Enabled = False
        cmdLoad.Enabled = False

        lblStatus.Caption = "Saving..."

        frmMainGame.Socket.SendData "savebook" & SEP_CHAR & Current & SEP_CHAR & EncodeBookText(txtBookTitle.Text) & SEP_CHAR & EncodeBookText(txtBookHeader.Text) & SEP_CHAR & EncodeBookText(txtPage1.Text) & SEP_CHAR & EncodeBookText(txtPage2.Text) & SEP_CHAR & BookIds(cmbBook.ListIndex) & SEP_CHAR & QuestIds(cmbQuest.ListIndex) & END_CHAR
    End Sub

    Public Sub Saved(ByVal id As Long)
        If id <> Current Then Exit Sub

        Saving = False
        BookEditorOpen = False
        BookPreviewOpen = False
        Unload Me
    End Sub

    Public Sub SaveFailed(ByVal message As String)
        Saving = False

        cmdLoad.Enabled = True
        cmdOk.Enabled = (Current > 0 And cmdPreview.Enabled)

        lblStatus.Caption = message

        GameMsgBox message, vbExclamation, "Book Editor"
    End Sub

    Private Sub cmdPreview_Click()
        Dim title As String

        title = txtBookHeader.Text

        If Len(title) = 0 Then
            title = txtBookTitle.Text
        End If

        LinkedBookId = 0
        BookPreviewOpen = True

        frmMainGame.DisplayBookPages Current, 1, 2, title, txtPage1.Text, txtPage2.Text

        Me.Hide

        BookEditorOpen = False

        ReleaseGameKeys
    End Sub

    Public Sub ReturnFromPreview()
        BookPreviewOpen = False
        BookEditorOpen = True

        Me.Show vbModeless, frmMainGame
        Me.ZOrder 0
    End Sub

    Private Sub cmdCancel_Click()
        Unload Me
    End Sub

    Private Sub Form_Unload(Cancel As Integer)
        If Saving Then
            Cancel = 1
            Exit Sub
        End If

        BookEditorOpen = False
        BookPreviewOpen = False

        ReleaseGameKeys
    End Sub
End Class