<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>XtremeWorlds.Client.Common</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.vb</DefaultItemExcludes>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <PackageReference Include="Eto.Forms" Version="2.12.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*.*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\Core\Assets\frmAlert\**\*.*">
      <Link>Assets\frmAlert\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Folder Include="Assets\frmGamePrompt\" />
  </ItemGroup>
</Project>