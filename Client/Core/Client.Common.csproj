<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>XtremeWorlds.Client.Common</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.vb</DefaultItemExcludes>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Assets\frmGamePrompt\**" />
    <EmbeddedResource Remove="Assets\frmGamePrompt\**" />
    <None Remove="Assets\frmGamePrompt\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <PackageReference Include="Eto.Forms" Version="2.12.0" />
  </ItemGroup>

  <!--
    The canonical game UI artwork lives in the repository-level Core/Assets
    directory. Client.Common is the assembly that owns AssetLoader, so link
    those files into this project as embedded resources and also copy them to
    the application output. AssetLoader can therefore resolve either the
    embedded resource or Assets/<relative path> at runtime.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Core\Assets\**\*.*">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>

    <Content Include="..\..\Core\Assets\**\*.*">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\frmDrop\" />
    <Folder Include="Assets\frmMainGame\" />
    <Folder Include="Assets\frmSendGetData\" />
    <Folder Include="Assets\frmSignEditor\" />
    <Folder Include="Assets\frmTrade\" />
  </ItemGroup>
</Project>
