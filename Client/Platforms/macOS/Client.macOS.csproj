<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0-macos14.0</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('OSX'))">net10.0</TargetFramework>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('OSX'))">Exe</OutputType>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('OSX'))">Library</OutputType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('OSX'))">14.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-x64;osx-arm64</RuntimeIdentifiers>
    <RootNamespace></RootNamespace>
    <AssemblyName>XtremeWorlds.Client.macOS</AssemblyName>
    <StartupObject Condition="$([MSBuild]::IsOSPlatform('OSX'))">XtremeWorlds.Client.macOS.Program</StartupObject>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.vb</DefaultItemExcludes>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Reference Include="Microsoft.VisualBasic" />
    <ProjectReference Include="..\..\Core\Client.Common.csproj" />
    <ProjectReference Include="..\..\Engine\Client.Engine.csproj" />
    <PackageReference Include="Eto.Platform.macOS" Version="2.12.0" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
    <Compile Remove="Program.cs" />
  </ItemGroup>
</Project>
