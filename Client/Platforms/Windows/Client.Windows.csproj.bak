<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>XtremeWorlds.Client.Windows</RootNamespace>
    <AssemblyName>XtremeWorlds.Client.Windows</AssemblyName>
    <StartupObject>XtremeWorlds.Client.Windows.Program</StartupObject>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Client.Eto.Core.vbproj" />
    <ProjectReference Include="..\..\Engine\Client.Engine.csproj" />
    <PackageReference Include="Eto.Platform.Wpf" Version="2.12.0" />
  </ItemGroup>

  <!-- Keep the Eto images embedded in Core, but also copy the actual files to
       the Windows output so the skin never depends on resource-name mangling. -->
  <ItemGroup>
    <Content Include="..\..\Core\Assets\**\*.*">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
