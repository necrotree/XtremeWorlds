[FormDesignerId("2F9766CC-FE5E-4939-B3D1-67FDD49EB783")]
[ClassId("4B9F470E-B4BD-4F92-A25B-35118941EB62")]
[InterfaceId("ECDA9E1A-2EF7-4EF8-BF39-C986B63F5C07")]
[EventInterfaceId("2BBC2F71-E826-44CC-9EBE-E0E676373445")]
Class frmDrop
    Attribute VB_Name = "frmDrop"
    Attribute VB_GlobalNameSpace = False
    Attribute VB_Creatable = False
    Attribute VB_PredeclaredId = True
    Attribute VB_Exposed = False
    Option Explicit
    
    Private Ammount As Long
    Private DropSlot As Long
    Private DropItemNum As Long
    
    Private Sub Form_Load()
        Me.Caption = GAME_NAME & " :: Drop Item"
    End Sub

    Public Sub OpenForSlot(ByVal slot As Long)
        If MyIndex < 1 Or slot < 1 Or slot > MAX_INV Then Exit Sub
        If GetPlayerInvItemNum(MyIndex, slot) < 1 Or GetPlayerInvItemNum(MyIndex, slot) > MAX_ITEMS Then Exit Sub
        DropSlot = slot
        DropItemNum = GetPlayerInvItemNum(MyIndex, slot)
        Ammount = 1
        Me.Show vbModeless
        lblName.Caption = Trim$(Item(DropItemNum).name)
        ProcessAmmount
    End Sub

    Private Sub cmdOK_Click()
        If Not InGame Or Not IsConnected Then Unload Me: Exit Sub
        If DropSlot < 1 Or DropSlot > MAX_INV Then Unload Me: Exit Sub
        If GetPlayerInvItemNum(MyIndex, DropSlot) <> DropItemNum Then Unload Me: Exit Sub
        If GetPlayerInvItemValue(MyIndex, DropSlot) < Ammount Then Exit Sub
        SendDropItem DropSlot, Ammount
        Unload Me
    End Sub

    Private Sub cmdCancel_Click()
        Unload Me
    End Sub
    
    Private Sub cmdPlus1_Click()
        ChangeAmount 1
    End Sub
    
    Private Sub cmdMinus1_Click()
        ChangeAmount -1
    End Sub
    
    Private Sub cmdPlus10_Click()
        ChangeAmount 10
    End Sub
    
    Private Sub cmdMinus10_Click()
        ChangeAmount -10
    End Sub
    
    Private Sub cmdPlus100_Click()
        ChangeAmount 100
    End Sub
    
    Private Sub cmdMinus100_Click()
        ChangeAmount -100
    End Sub
    
    Private Sub cmdPlus1000_Click()
        ChangeAmount 1000
    End Sub
    
    Private Sub cmdMinus1000_Click()
        ChangeAmount -1000
    End Sub
    
    Private Sub ChangeAmount(ByVal delta As Long)
        Dim amount As Double
        amount = CDbl(Ammount) + delta
        If amount < 1 Then amount = 1
        If amount > 2147483647# Then amount = 2147483647#
        Ammount = CLng(amount)
        ProcessAmmount
    End Sub

    Private Sub ProcessAmmount()
        Dim maximum As Long
        If Not InGame Or DropSlot < 1 Or DropSlot > MAX_INV Then Unload Me: Exit Sub
        If GetPlayerInvItemNum(MyIndex, DropSlot) <> DropItemNum Then Unload Me: Exit Sub
        maximum = GetPlayerInvItemValue(MyIndex, DropSlot)
        If maximum < 1 Then Unload Me: Exit Sub
        If Ammount > maximum Then Ammount = maximum
        If Ammount < 1 Then Ammount = 1
        lblAmmount.Caption = Ammount & "/" & maximum
    End Sub

End Class
