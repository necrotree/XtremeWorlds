[FormDesignerId("F747C5DD-28FC-443A-9E4B-3D49FE43C0AC")]
[ClassId("BCC21470-A2FC-492B-B753-82927EA4BC8C")]
[InterfaceId("63E6CF40-ED5E-431A-9BF3-359B16795EDF")]
[EventInterfaceId("1483909F-FEC9-4EF1-88A1-6C8792F3E49D")]
Class frmClassEditor
    Attribute VB_Name = "frmEditor_Class"
    Attribute VB_GlobalNameSpace = False
    Attribute VB_Creatable = False
    Attribute VB_PredeclaredId = True
    Attribute VB_Exposed = False
    Option Explicit
    Private mBusy As Boolean
    Private mSaving As Boolean
    
    Private Sub Form_Load()
        SyncValues
    End Sub
    
    Private Sub scrlSTR_Change()
        lblSTR.Caption = CStr(scrlSTR.Value)
    End Sub
    
    Private Sub scrlSTR_Scroll()
        scrlSTR_Change
    End Sub
    
    Private Sub scrlDEF_Change()
        lblDEF.Caption = CStr(scrlDEF.Value)
    End Sub
    
    Private Sub scrlDEF_Scroll()
        scrlDEF_Change
    End Sub
    
    Private Sub scrlSPD_Change()
        lblSPD.Caption = CStr(scrlSPD.Value)
    End Sub
    
    Private Sub scrlSPD_Scroll()
        scrlSPD_Change
    End Sub
    
    Private Sub scrlMAGI_Change()
        lblMAGI.Caption = CStr(scrlMAGI.Value)
    End Sub
    
    Private Sub scrlMAGI_Scroll()
        scrlMAGI_Change
    End Sub
  
    Private Sub cmdOK_Click()
        SaveClass
        Unload Me
    End Sub
    
    Private Sub cmdCancel_Click()
        Unload Me
    End Sub
    
    Private Sub SaveClass()
        If mSaving Then Exit Sub
        If InStr(txtName.Text, SEP_CHAR) > 0 Or InStr(txtName.Text, END_CHAR) > 0 Then
            GameMsgBox "The name contains an unsupported character.", vbExclamation
            Exit Sub
        End If
        mSaving = True
        lblStatus.Caption = "Saving class " & EditorIndex & "..."
        SendData "SAVECLASS" & SEP_CHAR & EditorIndex & SEP_CHAR & Trim$(txtName.Text) & SEP_CHAR & scrlMSprite.Value & SEP_CHAR & scrlFSprite.Value & SEP_CHAR & scrlSTR.Value & SEP_CHAR & scrlDEF.Value & SEP_CHAR & scrlSPD.Value & SEP_CHAR & scrlMAGI.Value & SEP_CHAR & scrlMap.Value & SEP_CHAR & scrlX.Value & SEP_CHAR & scrlY.Value & END_CHAR()()
    End Sub
    
    Private Sub SyncValues()
        lblSTR.Caption = CStr(scrlSTR.Value)
        lblDEF.Caption = CStr(scrlDEF.Value)
        lblSPD.Caption = CStr(scrlSPD.Value)
        lblMAGI.Caption = CStr(scrlMAGI.Value)
        lblMap.Caption = CStr(scrlMap.Value)
        lblX.Caption = CStr(scrlX.Value)
        lblY.Caption = CStr(scrlY.Value)
    End Sub
    
    Private Sub scrlMap_Change()
        lblMap.Caption = CStr(scrlMap.Value)
    End Sub
    
    Private Sub scrlX_Change()
        lblX.Caption = CStr(scrlX.Value)
    End Sub
    
    Private Sub scrlY_Change()
        lblY.Caption = CStr(scrlY.Value)
    End Sub
    
    Private Sub scrlFSprite_Change()
        lblSprite2.Caption = CStr(scrlFSprite.Value)
        imgFSprite.Picture = MenuSpritePicture(scrlFSprite.Value)
    End Sub
    
    Private Sub scrlMSprite_Change()
        lblSprite.Caption = CStr(scrlMSprite.Value)
        imgMSprite.Picture = MenuSpritePicture(scrlMSprite.Value)
    End Sub
    

End Class
