[FormDesignerId("A7861337-9ED5-407A-8B43-FC37E9424008")]
[ClassId("F8DDB162-3354-46E6-8C64-8A594CB191EA")]
[InterfaceId("7236FD29-72C4-4690-9853-41A5A721CC4D")]
[EventInterfaceId("BC369AC1-9A94-4C64-9FF1-8087951FD677")]
Class frmIndex
    Attribute VB_Name = "frmIndex"
    Attribute VB_GlobalNameSpace = False
    Attribute VB_Creatable = False
    Attribute VB_PredeclaredId = True
    Attribute VB_Exposed = False
    Option Explicit
    Private Selecting As Boolean
    
    Private Sub cmdOK_Click()
        If lstIndex.ListIndex < 0 Then Exit Sub
        Selecting = True
        EditorIndex = lstIndex.ListIndex + 1
        If InEmoteEditor Then
            ResetEditorIndexState
            SendData "editemoticon" & SEP_CHAR & EditorIndex & END_CHAR
            Unload Me
            Exit Sub
        End If
        If InQuestEditor Then
            ResetEditorIndexState
            QuestEditorPending = EditorIndex
            Call SendData("EDITQUESTDIALOGUE" & SEP_CHAR & EditorIndex & END_CHAR)
            Unload Me
            Exit Sub
        End If

        If InBookEditor Then
            frmBookEditor.SelectBookForEdit EditorIndex
            InBookEditor = False
            Call SendData("EDITBOOK" & SEP_CHAR & EditorIndex & END_CHAR)
            Unload Me
            Exit Sub
        End If
    
        If InItemsEditor = True Then
            Call SendData("EDITITEM" & SEP_CHAR & EditorIndex & END_CHAR)
        End If
        If InNpcEditor = True Then
            Call SendData("EDITNPC" & SEP_CHAR & EditorIndex & END_CHAR)
        End If
        If InShopEditor = True Then
            Call SendData("EDITSHOP" & SEP_CHAR & EditorIndex & END_CHAR)
        End If
        If InSpellEditor = True Then
            Call SendData("EDITSPELL" & SEP_CHAR & EditorIndex & END_CHAR)
        End If
        If InSignEditor = True Then
            Call SendData("EDITSIGN" & SEP_CHAR & EditorIndex & END_CHAR)
        End If
        If InArrowEditor = True Then
            Call SendData("EDITARROW" & SEP_CHAR & EditorIndex & END_CHAR)
        End If
        If InClassEditor = True Then
            Call SendData("EDITCLASS" & SEP_CHAR & EditorIndex & END_CHAR)
        End If
            
        ResetEditorIndexState
        Unload frmIndex
    End Sub
    
    Private Sub cmdCancel_Click()
        Unload frmIndex
    End Sub

    Private Sub Form_Unload(Cancel As Integer)
        If Selecting Then Exit Sub
        ResetEditorIndexState
        If Not QuestEditorOpen Then Unload frmQuestEditor
        If Not BookEditorOpen Then Unload frmBookEditor
    End Sub
    
    

End Class
