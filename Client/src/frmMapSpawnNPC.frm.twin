[FormDesignerId("FB91C191-2D3A-4D79-97DF-0310CD5864FB")]
[ClassId("00A36A4C-0AED-4955-9FE6-86A62119DBA5")]
[InterfaceId("994ECD64-2D14-4000-B539-F3319768B727")]
[EventInterfaceId("D4682552-0FC6-4BA7-AD36-71831F839904")]
Class frmMapSpawnNPC
    Attribute VB_Name = "frmMapSpawnNPC"
    Attribute VB_GlobalNameSpace = False
    Attribute VB_Creatable = False
    Attribute VB_PredeclaredId = True
    Attribute VB_Exposed = False
    Private Sub cmdCancel_Click()
        Unload Me
    End Sub
    
    Private Sub cmdOK_Click()
        SpawnNpcNum = lstNPC.ListIndex + 1
        SpawnNpcDir = cmbNPCDir.ListIndex
        SpawnNpcStill = chkStationary.Value
        Unload Me
    End Sub
    
    Private Sub Form_Load()
        Dim n As Long
    
        For n = 1 To MAX_MAP_NPCS
            If Map.Npc(n) > 0 Then
                lstNPC.AddItem n & ": " & Npc(Map.Npc(n)).name
            Else
                lstNPC.AddItem n & ": No Npc"
            End If
        Next n
    End Sub
    
    

End Class
