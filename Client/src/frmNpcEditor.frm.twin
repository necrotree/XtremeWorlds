[FormDesignerId("8796DDAA-C8CF-45AD-80AC-5E200A8AFCD5")]
[ClassId("5A8E7639-09FE-4A74-89B1-E636E5ECC619")]
[InterfaceId("EDF3F731-3EB9-44E9-B11D-2E31483C5F4C")]
[EventInterfaceId("B4D13E1C-A0A1-4369-9C9F-A307C0E5847D")]
Class frmNpcEditor
    Attribute VB_Name = "frmNpcEditor"
    Attribute VB_GlobalNameSpace = False
    Attribute VB_Creatable = False
    Attribute VB_PredeclaredId = True
    Attribute VB_Exposed = False
    Option Explicit
    
    Public Sub BeginQuestList()
        cmbQuestId.Clear
        cmbQuestId.AddItem "None"
        cmbQuestId.ItemData(0) = 0
        cmbQuestId.ListIndex = 0
    End Sub

    Public Sub AddQuestName(ByVal id As Long, ByVal title As String)
        If id < 1 Then Exit Sub
        cmbQuestId.AddItem CStr(id) & ": " & title
        cmbQuestId.ItemData(cmbQuestId.NewIndex) = id
    End Sub

    Public Sub SelectQuestId(ByVal id As Long)
        Dim i As Long
        If cmbQuestId.ListCount = 0 Then BeginQuestList
        cmbQuestId.ListIndex = 0
        For i = 0 To cmbQuestId.ListCount - 1
            If cmbQuestId.ItemData(i) = id Then
                cmbQuestId.ListIndex = i
                Exit Sub
            End If
        Next i
        If id > 0 Then
            AddQuestName id, "(unavailable)"
            cmbQuestId.ListIndex = cmbQuestId.NewIndex
        End If
    End Sub

    Public Function SelectedQuestId() As Long
        If cmbQuestId.ListIndex >= 0 Then SelectedQuestId = cmbQuestId.ItemData(cmbQuestId.ListIndex)
    End Function

    Private Sub cmbBehavior_Click()
        cmbQuestId.Visible = cmbBehavior.ListIndex = NPC_BEHAVIOR_QUESTGIVER
        If cmbBehavior.ListIndex = NPC_BEHAVIOR_SHOPKEEPER Then
            lbl17.Caption = "Shopkeeper's Shop"
            lbl17.Visible = True
            cmbShop.Visible = True
        ElseIf cmbBehavior.ListIndex = NPC_BEHAVIOR_QUESTGIVER Then
            lbl17.Caption = "Quest ID"
            lbl17.Visible = True
            cmbShop.Visible = False
        Else
            lbl17.Visible = False
            cmbShop.Visible = False
        End If
    End Sub
    
    Private Sub Form_Load()
        Dim X As Long
        cmbBehavior.AddItem "Quest giver"
        cmbShop.AddItem "No Shop"
        For X = 1 To MAX_SHOPS
            cmbShop.AddItem X & ": " & Trim$(Shop(X).name)
        Next X
    End Sub
    
    Private Sub lblExpGiven_Click()
    
    End Sub
    
    Private Sub scrlSprite_Change()
        lblSprite.Caption = Str(scrlSprite.Value)
        imgSprite.Picture = MenuSpritePicture(scrlSprite.Value)
    End Sub
    
    Private Sub scrlRange_Change()
        lblRange.Caption = Str(scrlRange.Value)
    End Sub
    
    Private Sub scrlSTR_Change()
        lblSTR.Caption = Str(scrlSTR.Value)
    ' lblStartHP.Caption = STR(scrlSTR.Value * scrlDEF.Value)
    ' lblExpGiven.Caption = STR(scrlSTR.Value * scrlDEF.Value * 2)
    End Sub
    
    Private Sub scrlDEF_Change()
        lblDEF.Caption = Str(scrlDEF.Value)
    ' lblStartHP.Caption = STR(scrlSTR.Value * scrlDEF.Value)
    ' lblExpGiven.Caption = STR(scrlSTR.Value * scrlDEF.Value * 2)
    End Sub
    
    Private Sub scrlSPEED_Change()
        lblSPEED.Caption = Str(scrlSPEED.Value)
    ' lblExpGiven.Caption = STR(scrlSTR.Value * scrlDEF.Value * 2)
    End Sub
    
    Private Sub scrlMAGI_Change()
        lblMAGI.Caption = Str(scrlMAGI.Value)
    End Sub
    
    Private Sub scrlNum_Change()
        lblNum.Caption = Str(scrlNum.Value)
        If scrlNum.Value > 0 Then
            lblItemName.Caption = Trim$(Item(scrlNum.Value).name)
        End If
    End Sub
    
    Private Sub scrlValue_Change()
        lblValue.Caption = Str(scrlValue.Value)
    End Sub
    
    Private Sub cmdOK_Click()
        Call NpcEditorOk
    End Sub
    
    Private Sub cmdCancel_Click()
        Call NpcEditorCancel
    End Sub

End Class
