<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.vb</DefaultItemExcludes>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <!-- Legacy Eto editors are no longer compiled into the browser client. -->
    <Compile Remove="ToolController.cs;Forms/**/*.cs" />
    <PackageReference Include="Eto.Forms" Version="2.12.0" />
    <EmbeddedResource Include="Designers/*.tbform" />
    <Content Include="../Assets/gfx/emote.png;../Assets/gfx/arrows.png;../Assets/gfx/items.png;../Assets/gfx/spells.png;../Assets/gfx/sprites.png;../Assets/gfx/tiles*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>tool-assets/%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>