<Project>
  <PropertyGroup>
    <DefaultItemExcludes>
      $(DefaultItemExcludes);
      $(MSBuildThisFileDirectory)src\**;
      $(MSBuildThisFileDirectory)**\*.vb;
      $(MSBuildThisFileDirectory)**\bin\**;
      $(MSBuildThisFileDirectory)**\obj\**
    </DefaultItemExcludes>
  </PropertyGroup>
</Project>
