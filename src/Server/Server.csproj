<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Server</RootNamespace>
    <AssemblyName>Server</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.vb;$(ProjectDir)src\**</DefaultItemExcludes>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="com.MirrorNetworking.Telepathy" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Database\**\*.cs" />
    <Compile Include="Game\**\*.cs" />
    <Compile Include="Models\**\*.cs" />
    <Compile Include="Networking\**\*.cs" />
    <Compile Include="Protocol\**\*.cs" />
    <Compile Include="Security\**\*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="ServerForm.cs" />
    <Compile Include="ScriptEditorForm.cs" />
    <Compile Include="WpfServerSkin.cs" />
    <Compile Include="ServerHost.cs" />
    <Compile Include="ServerSettings.cs" />
    <Compile Include="ServerLogWriter.cs" />
    <Compile Include="SpacetimeLocalProcess.cs" />
    <Compile Include="PublicIpResolver.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\appsettings.json"
          Link="appsettings.json"
          CopyToOutputDirectory="Always" />
    <Content Include="Icon.ico"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="scripts\**\*.lua"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\spacetimedb\**\*"
          Link="spacetimedb\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>


  <Target Name="CleanSpacetimeModuleOutput" BeforeTargets="CopyFilesToOutputDirectory">
    <RemoveDir Directories="$(OutDir)spacetimedb" />
  </Target>


  <Target Name="SyncSpacetimeModuleSource" BeforeTargets="Build">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\spacetimedb" />
    <ItemGroup>
      <_SpacetimeModuleFiles Include="$(MSBuildProjectDirectory)\..\..\spacetimedb\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SpacetimeModuleFiles)"
          DestinationFiles="@(_SpacetimeModuleFiles->'$(MSBuildProjectDirectory)\spacetimedb\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
